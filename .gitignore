# asset and test-fixture folders.
*.[jJ][pP][gG]
*.[jJ][pP][eE][gG]
*.[jJ][pP][eE]
*.[pP][nN][gG]
*.[hH][eE][iI][cCfF]
*.[tT][iI][fF]
*.[tT][iI][fF][fF]
*.[dD][nN][gG]
!docs/**/*.png
!assets/**/*.png
!tests/**/fixtures/**
samples/
customer-photos/
Original/


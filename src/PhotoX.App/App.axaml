<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:PhotoX.App"
             x:Class="PhotoX.App.App"
             RequestedThemeVariant="Dark">
  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Resources>
    <SolidColorBrush x:Key="BgBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="BarBrush" Color="#191919" />
    <SolidColorBrush x:Key="PanelBrush" Color="#242424" />
    <SolidColorBrush x:Key="Panel2Brush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="RaisedBrush" Color="#353535" />
    <SolidColorBrush x:Key="BorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="Border2Brush" Color="#474747" />
    <SolidColorBrush x:Key="CanvasBrush" Color="#151515" />
    <SolidColorBrush x:Key="TextBrush" Color="#EDEDED" />
    <SolidColorBrush x:Key="Text2Brush" Color="#A8A8A8" />
    <SolidColorBrush x:Key="Text3Brush" Color="#7A7A7A" />
    <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="AccentTintBrush" Color="#1D3557" />
    <SolidColorBrush x:Key="OkBrush" Color="#34C759" />
    <SolidColorBrush x:Key="WarnBrush" Color="#F5A524" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF5A52" />
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="Window">
      <Setter Property="Background" Value="{StaticResource BgBrush}" />
    </Style>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="0.7" />
      <Setter Property="Foreground" Value="{StaticResource Text3Brush}" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
    </Style>

    <!-- Buttons -->
    <Style Selector="Button">
      <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource Border2Brush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="14,6" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#2563EB" />
      <Setter Property="BorderBrush" Value="#2563EB" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#24406B" />
      <Setter Property="Foreground" Value="#9DB3D3" />
    </Style>
    <Style Selector="Button.chip">
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="12,4" />
      <Setter Property="Background" Value="{StaticResource Panel2Brush}" />
    </Style>
    <Style Selector="Button.chip.selected">
      <Setter Property="Background" Value="{StaticResource AccentTintBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground" Value="#D6E6FF" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.list">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style Selector="Button.list:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource Text3Brush}" />
    </Style>
    <Style Selector="Button.film">
      <Setter Property="Background" Value="{StaticResource CanvasBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.film.current">
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="3" />
    </Style>
    <Style Selector="Button.square">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="18" />
    </Style>
    <Style Selector="Border.kbd">
      <Setter Property="Background" Value="#33FFFFFF" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.kbd > TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Workspace and language switches -->
    <Style Selector="ToggleButton.seg">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
      <Setter Property="Padding" Value="16,6" />
      <Setter Property="MinHeight" Value="30" />
    </Style>
    <Style Selector="ToggleButton.seg:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style Selector="ToggleButton.lang:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="Slider">
      <Setter Property="Focusable" Value="False" />
    </Style>
    <Style Selector="ProgressBar">
      <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
      <Setter Property="Background" Value="#4A4A4A" />
      <Setter Property="MinHeight" Value="6" />
      <Setter Property="CornerRadius" Value="3" />
    </Style>
  </Application.Styles>
</Application>

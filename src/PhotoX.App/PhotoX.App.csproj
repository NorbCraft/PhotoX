<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>PhotoX.App</RootNamespace>
    <AssemblyName>PhotoX</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\logo\photox.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="..\..\assets\logo\photox.ico" Link="Assets\photox.ico" />
    <AvaloniaResource Include="..\..\assets\logo\photox-icon-256.png" Link="Assets\photox-icon-256.png" />
    <EmbeddedResource Include="Localization\Strings_*.json" LogicalName="PhotoX.Strings.%(Filename).json" WithCulture="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Velopack" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PhotoX.Core\PhotoX.Core.csproj" />
    <ProjectReference Include="..\PhotoX.Imaging\PhotoX.Imaging.csproj" />
    <ProjectReference Include="..\PhotoX.Storage\PhotoX.Storage.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PhotoX.App.Tests" />
  </ItemGroup>
</Project>

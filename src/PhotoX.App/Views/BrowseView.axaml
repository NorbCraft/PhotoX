<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:PhotoX.App.Controls"
             xmlns:vm="using:PhotoX.App.ViewModels"
             xmlns:l="using:PhotoX.App.Localization"
             xmlns:s="using:PhotoX.App.Services"
             xmlns:v="using:PhotoX.App.Views"
             x:Class="PhotoX.App.Views.BrowseView"
             x:DataType="vm:BrowseViewModel">
  <Grid x:Name="Root" ColumnDefinitions="290,Auto,*,Auto,330">

    <!-- Explorer (FR-001), the same control as in ID Photos and Collages (prompt_04 §6); resizable (prompt_06 §1);
         hidden and shown with the toolbar button (prompt_08 §4) -->
    <Border x:Name="TreePanel" Grid.Column="0" Background="{DynamicResource PanelBrush}">
      <v:ExplorerView DataContext="{Binding Explorer}" />
    </Border>
    <GridSplitter x:Name="TreeSplitter" Grid.Column="1" Classes="panel" ResizeDirection="Columns" DragCompleted="OnLeftSplitterDragCompleted" />

    <!-- Gallery (FR-002) -->
    <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*">
      <StackPanel Margin="24,16,24,8" Spacing="12">
        <!-- Up and the open folder (prompt_08 §1) -->
        <v:LocationBar DataContext="{Binding Explorer}" IsVisible="{Binding $parent[UserControl].((vm:BrowseViewModel)DataContext).HasFolder}" />
        <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="chip" Focusable="False" Classes.selected="{Binding Filter, Converter={x:Static s:EqualsConverter.Instance}, ConverterParameter=All}"
                  Command="{Binding SetFilterCommand}" CommandParameter="{x:Static vm:PhotoFilter.All}">
            <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{l:Tr FilterAll}" /><TextBlock Text="{Binding CountAll}" Opacity="0.7" /></StackPanel>
          </Button>
          <Button Classes="chip" Focusable="False" Classes.selected="{Binding Filter, Converter={x:Static s:EqualsConverter.Instance}, ConverterParameter=ToDo}"
                  Command="{Binding SetFilterCommand}" CommandParameter="{x:Static vm:PhotoFilter.ToDo}">
            <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{l:Tr FilterToDo}" /><TextBlock Text="{Binding CountToDo}" Opacity="0.7" /></StackPanel>
          </Button>
          <Button Classes="chip" Focusable="False" Classes.selected="{Binding Filter, Converter={x:Static s:EqualsConverter.Instance}, ConverterParameter=Done}"
                  Command="{Binding SetFilterCommand}" CommandParameter="{x:Static vm:PhotoFilter.Done}">
            <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{l:Tr FilterDone}" /><TextBlock Text="{Binding CountDone}" Opacity="0.7" /></StackPanel>
          </Button>
          <!-- Deleted photos, kept in “Original” until Discard originals (prompt_08 §5) -->
          <Button Classes="chip" Focusable="False" Classes.selected="{Binding Filter, Converter={x:Static s:EqualsConverter.Instance}, ConverterParameter=Deleted}"
                  Command="{Binding SetFilterCommand}" CommandParameter="{x:Static vm:PhotoFilter.Deleted}" ToolTip.Tip="{l:Tr FilterDeletedTip}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Path Data="{x:Static s:Icons.Delete}" Stroke="{DynamicResource Text2Brush}" StrokeThickness="1.6" StrokeJoin="Round" StrokeLineCap="Round" Width="24" Height="24" Stretch="None" Margin="-4,-6" VerticalAlignment="Center" RenderTransform="scale(0.75)" />
              <TextBlock Text="{l:Tr FilterDeleted}" /><TextBlock Text="{Binding CountDeleted}" Opacity="0.7" />
            </StackPanel>
          </Button>
        </StackPanel>
        <!-- Thumbnail size (prompt_06 §4): left smaller, right larger, double-click for the default -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" ToolTip.Tip="{l:Tr ThumbSizeTip}">
          <Path Data="{x:Static s:Icons.ThumbSmall}" Stroke="{DynamicResource Text2Brush}" StrokeThickness="1.6" StrokeJoin="Round" Width="24" Height="24" Stretch="None" VerticalAlignment="Center" />
          <Slider Width="120" Margin="0,-12" Minimum="{x:Static vm:BrowseViewModel.MinThumbScale}" Maximum="{x:Static vm:BrowseViewModel.MaxThumbScale}"
                  Value="{Binding ThumbScale}" VerticalAlignment="Center" DoubleTapped="OnThumbSizeDoubleTapped" />
          <Path Data="{x:Static s:Icons.ThumbLarge}" Stroke="{DynamicResource Text2Brush}" StrokeThickness="1.6" StrokeJoin="Round" Width="24" Height="24" Stretch="None" VerticalAlignment="Center" />
        </StackPanel>
        </Grid>
      </StackPanel>
      <Border Grid.Row="1" IsVisible="{Binding IsRemovable}" Margin="24,0,24,8" Background="{DynamicResource WarnBgBrush}" BorderBrush="{DynamicResource WarnBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8">
        <TextBlock Text="{l:Tr RemovableWarning}" Foreground="{DynamicResource WarnTextBrush}" TextWrapping="Wrap" />
      </Border>
      <TextBlock Grid.Row="2" IsVisible="{Binding !HasFolder}" Text="{l:Tr NoFolder}" Classes="muted" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
      <TextBlock Grid.Row="2" IsVisible="{Binding ShowNoPhotos}" Text="{Binding EmptyText}" Classes="muted" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
      <TextBlock Grid.Row="2" IsVisible="{Binding IsScanning}" Text="{l:Tr Loading}" Classes="muted" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
      <!-- Ctrl + click and Shift + click select several photos; Ctrl + A selects all (prompt_05 §5; no permanent hint, prompt_06 §4) -->
      <ListBox Grid.Row="2" x:Name="Gallery" Margin="16,0,8,8" Background="Transparent" ItemsSource="{Binding GalleryItems}" SelectedItem="{Binding SelectedGalleryItem}"
               SelectionMode="Multiple" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="CornerRadius" Value="9" />
          </Style>
          <Style Selector="ListBoxItem:selected /template/ ContentPresenter, ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
          </Style>
          <!-- Card look lives in styles (not local values), so the selected style can override it. -->
          <Style Selector="Border.card">
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
          </Style>
          <!-- The selected photo is clearly marked (prompt_03 §2) -->
          <Style Selector="ListBoxItem:selected Border.card">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
            <Setter Property="BorderThickness" Value="3" />
            <Setter Property="BoxShadow" Value="0 0 0 3 #553B82F6" />
          </Style>
          <Style Selector="ListBoxItem:selected TextBlock.name">
            <Setter Property="Foreground" Value="{DynamicResource SelectedTextBrush}" />
          </Style>
          <Style Selector="ListBoxItem:pointerover Border.card">
            <Setter Property="BorderBrush" Value="{DynamicResource Border2Brush}" />
          </Style>
          <!-- A deleted photo is shown faded: it can only be restored -->
          <Style Selector="Border.card.deleted Image">
            <Setter Property="Opacity" Value="0.55" />
          </Style>
        </ListBox.Styles>
        <!-- Subfolders first, as folder cards (prompt_08 §1), then the photos -->
        <ListBox.DataTemplates>
          <DataTemplate x:DataType="vm:FolderItemViewModel">
            <v:FolderCard Width="{Binding $parent[ListBox].((vm:BrowseViewModel)DataContext).CardWidth}" Height="{Binding $parent[ListBox].((vm:BrowseViewModel)DataContext).CardHeight}" />
          </DataTemplate>
          <DataTemplate x:DataType="vm:PhotoItemViewModel">
            <Border Classes="card" Classes.deleted="{Binding IsDeleted}" CornerRadius="9" DoubleTapped="OnPhotoDoubleTapped"
                    Width="{Binding $parent[ListBox].((vm:BrowseViewModel)DataContext).CardWidth}" Height="{Binding $parent[ListBox].((vm:BrowseViewModel)DataContext).CardHeight}">
              <Border.ContextMenu>
                <!-- Right-click actions (prompt_04 §4) -->
                <ContextMenu>
                  <MenuItem Header="{l:Tr EditSelected}" IsEnabled="{Binding IsOpenable}" IsVisible="{Binding !IsDeleted}" Click="OnEditClick">
                    <MenuItem.Icon><Path Classes="bi" Data="{x:Static s:Icons.Edit}" /></MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="{l:Tr UseForId}" IsEnabled="{Binding IsOpenable}" IsVisible="{Binding !IsDeleted}" Click="OnUseForIdClick">
                    <MenuItem.Icon><Path Classes="bi" Data="{x:Static s:Icons.IdPhoto}" /></MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="{l:Tr PrintMenu}" IsEnabled="{Binding IsOpenable}" IsVisible="{Binding !IsDeleted}" Click="OnPrintClick">
                    <MenuItem.Icon><Path Classes="bi" Data="{x:Static s:Icons.Printer}" /></MenuItem.Icon>
                  </MenuItem>
                  <Separator IsVisible="{Binding !IsDeleted}" />
                  <MenuItem Header="{l:Tr DuplicateImage}" IsVisible="{Binding !IsDeleted}" Click="OnDuplicateClick">
                    <MenuItem.Icon><Path Classes="bi" Data="{x:Static s:Icons.Duplicate}" /></MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="{l:Tr RestoreOriginal}" IsEnabled="{Binding IsOpenable}" IsVisible="{Binding !IsDeleted}" Click="OnRestoreClick">
                    <MenuItem.Icon><Path Classes="bi" Data="{x:Static s:Icons.Restore}" /></MenuItem.Icon>
                  </MenuItem>
                  <!-- Delete (prompt_08 §5): asks first; the photo moves to “Original” and can be restored from Deleted -->
                  <Separator IsVisible="{Binding !IsDeleted}" />
                  <MenuItem Header="{l:Tr DeleteMenu}" IsVisible="{Binding !IsDeleted}" Click="OnDeleteClick" InputGesture="Delete">
                    <MenuItem.Icon><Path Classes="bi" Data="{x:Static s:Icons.Delete}" /></MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="{l:Tr RestoreDeletedMenu}" IsVisible="{Binding IsDeleted}" Click="OnRestoreDeletedClick">
                    <MenuItem.Icon><Path Classes="bi" Data="{x:Static s:Icons.Restore}" /></MenuItem.Icon>
                  </MenuItem>
                </ContextMenu>
              </Border.ContextMenu>
              <Grid RowDefinitions="Auto,*" Margin="8">
                <Image Source="{Binding Thumbnail}" Stretch="Uniform" Height="{Binding $parent[ListBox].((vm:BrowseViewModel)DataContext).ThumbHeight}" />
                <TextBlock Text="…" IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNull}}" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Border IsVisible="{Binding HasBadge}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4" CornerRadius="10" Padding="7,1"
                        Background="{Binding IsWarning, Converter={x:Static s:IconConverter.BadgeBrush}}">
                  <TextBlock Text="{Binding IsWarning, Converter={x:Static s:IconConverter.BadgeGlyph}}" FontWeight="Bold" FontSize="12" Foreground="#151515" />
                </Border>
                <!-- Requested copies (prompt_09 §2): ×0 leaves the photo out of Print selected and Print all -->
                <Border Classes="quantity" Classes.excluded="{Binding IsExcluded}" IsVisible="{Binding !IsDeleted}" ToolTip.Tip="{Binding QuantityTip}">
                  <TextBlock Text="{Binding QuantityText}" />
                </Border>
                <!-- Print counter (prompt_05 §6): copies accepted by Windows through PhotoX -->
                <Border Classes="printcount" Classes.printed="{Binding IsPrinted}" ToolTip.Tip="{Binding PrintCountTip}">
                  <TextBlock Text="{Binding PrintCountText}" />
                </Border>
                <StackPanel Grid.Row="1" Margin="2,8,2,0" Spacing="2">
                  <TextBlock Classes="name" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding StateText}" FontSize="11.5" IsVisible="{Binding ShowStateLine}" Classes.warn="{Binding IsWarning}" Classes.ok="{Binding !IsWarning}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Info}" FontSize="11.5" IsVisible="{Binding !ShowStateLine}" Foreground="{DynamicResource Text3Brush}" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.DataTemplates>
      </ListBox>
    </Grid>

    <!-- Details (collapsible, FR-039; resizable, prompt_06 §1) -->
    <GridSplitter Grid.Column="3" Classes="panel" ResizeDirection="Columns" DragCompleted="OnRightSplitterDragCompleted" />
    <Border Grid.Column="4" Background="{DynamicResource PanelBrush}">
      <!-- The actions always show; the photo preview and progress fold away (FR-039). The preview takes the room that is
           left (at most 190 px, set in code), so in a short window it shrinks and the printing information, Copies and
           the actions stay in view (prompt_09 §3). -->
      <Grid x:Name="SideGrid" RowDefinitions="Auto,1000*,Auto,Auto,Auto,*,Auto" Margin="20,16,20,20">
          <Button Classes="list" Focusable="False" Padding="0,2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding ToggleDetailsCommand}" ToolTip.Tip="{l:Tr Details}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Classes="section" Text="{l:Tr SelectedPhoto}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding DetailsCollapsed, Converter={x:Static s:IconConverter.Chevron}}" Foreground="{DynamicResource Text3Brush}" FontSize="11" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Border x:Name="PreviewBox" Grid.Row="1" Background="{DynamicResource CanvasBrush}" CornerRadius="8" Padding="6" Margin="0,10,0,0" IsVisible="{Binding HasSelection}">
            <Image Source="{Binding SelectedPhoto.Thumbnail}" Stretch="Uniform" />
          </Border>
          <StackPanel Grid.Row="2" Spacing="6" IsVisible="{Binding HasSelection}">
            <TextBlock Text="{Binding SelectionText}" IsVisible="{Binding HasMultipleSelection}" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
            <StackPanel IsVisible="{Binding !HasMultipleSelection}" Spacing="4">
              <TextBlock Text="{Binding SelectedPhoto.Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,8,0,0" />
              <TextBlock Text="{Binding SelectedPhoto.Info}" Classes="muted" />
              <TextBlock Classes="muted" TextTrimming="CharacterEllipsis"><Run Text="{Binding SelectedPhoto.StateText}" /><Run Text="  ·  " /><Run Text="{Binding SelectedPhoto.PrintCountTip}" /></TextBlock>
              <TextBlock Text="{Binding SelectedPhoto.ErrorText}" Foreground="{DynamicResource WarnBrush}" TextWrapping="Wrap" IsVisible="{Binding SelectedPhoto.ErrorText, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
          </StackPanel>
          <!-- Edit progress of the open folder (prompt_06 §4) -->
          <StackPanel Grid.Row="3" Spacing="8" Margin="0,18,0,0" IsVisible="{Binding !DetailsCollapsed}">
            <TextBlock Classes="section" Text="{l:Tr EditProgress}" />
            <TextBlock Text="{Binding ProgressText}" FontSize="17" FontWeight="SemiBold" />
            <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" />
          </StackPanel>
          <!-- Printing information of the open folder (prompt_09 §3): photos with copies requested, copies printed -->
          <StackPanel Grid.Row="4" Spacing="4" Margin="0,18,0,0" IsVisible="{Binding HasFolder}">
            <TextBlock Classes="section" Text="{l:Tr PrintingInfo}" Margin="0,0,0,2" />
            <TextBlock x:Name="SelectedForPrint" Text="{Binding SelectedForPrintText}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" ToolTip.Tip="{l:Tr SelectedForPrintTip}" />
            <TextBlock x:Name="PrintedCopies" Text="{Binding PrintedText}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" ToolTip.Tip="{l:Tr PrintedCopiesTip}" />
          </StackPanel>
        <StackPanel Grid.Row="6" Margin="0,14,0,0" Spacing="14">
          <!-- Copies of the selected photos (prompt_09 §§3, 4): one value for the whole selection -->
          <StackPanel Spacing="2" IsVisible="{Binding !IsDeletedView}" IsEnabled="{Binding HasQuantityTargets}" ToolTip.Tip="{l:Tr CopiesTip}">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{l:Tr CopiesLabel}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <Button x:Name="QuantityMinus" Classes="square" Focusable="False" Content="−" Command="{Binding QuantityMinusCommand}" />
                <Border Background="{DynamicResource Panel2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Width="52" Height="34">
                  <TextBlock x:Name="QuantityValue" Text="{Binding QuantityValueText}" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Button x:Name="QuantityPlus" Classes="square" Focusable="False" Content="+" Command="{Binding QuantityPlusCommand}" />
              </StackPanel>
            </Grid>
            <TextBlock Text="{Binding QuantityNote}" IsVisible="{Binding HasQuantityNote}" Classes="muted" FontSize="12.5" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <!-- Under Deleted (prompt_08 §5): only Restore, and how long deleted photos are kept -->
          <StackPanel Spacing="10" IsVisible="{Binding IsDeletedView}">
            <TextBlock Text="{Binding DeletedNote}" Classes="muted" TextWrapping="Wrap" />
            <Button Classes="primary" Focusable="False" HorizontalAlignment="Stretch" MinHeight="46" Padding="8,6" Command="{Binding RestoreDeletedCommand}">
              <c:IconLabel Icon="{x:Static s:Icons.Restore}" Text="{l:Tr RestoreDeletedSelected}" TextElement.FontWeight="SemiBold" />
            </Button>
          </StackPanel>
          <!-- Actions (prompt_05 §5): print, edit or use one photo, restore the selection; Discard originals for the folder (prompt_08 §5) -->
          <StackPanel Spacing="8" IsVisible="{Binding !IsDeletedView}">
            <Grid ColumnDefinitions="*,8,*">
              <Button Classes="primary" Focusable="False" HorizontalAlignment="Stretch" MinHeight="46" Padding="8,6" Command="{Binding PrintSelectedCommand}" IsEnabled="{Binding HasSelection}">
                <c:IconLabel Icon="{x:Static s:Icons.Printer}" Text="{l:Tr PrintSelected}" TextElement.FontWeight="SemiBold" />
              </Button>
              <Button Grid.Column="2" Focusable="False" HorizontalAlignment="Stretch" MinHeight="46" Padding="8,6" Command="{Binding PrintAllCommand}" IsEnabled="{Binding HasFolder}">
                <c:IconLabel Icon="{x:Static s:Icons.Printer}" Text="{l:Tr PrintAll}" />
              </Button>
            </Grid>
            <Button Focusable="False" HorizontalAlignment="Stretch" Command="{Binding EditPhotoCommand}" IsEnabled="{Binding HasSingleSelection}">
              <Grid ColumnDefinitions="*,Auto">
                <c:IconLabel Icon="{x:Static s:Icons.Edit}" Text="{l:Tr EditSelected}" />
                <Border Grid.Column="1" Classes="kbd" Margin="8,0,0,0"><TextBlock Text="Enter" /></Border>
              </Grid>
            </Button>
            <Button Focusable="False" HorizontalAlignment="Stretch" Command="{Binding UseForIdCommand}" IsEnabled="{Binding HasSingleSelection}">
              <c:IconLabel Icon="{x:Static s:Icons.IdPhoto}" Text="{l:Tr UseForId}" />
            </Button>
            <Grid ColumnDefinitions="*,8,*">
              <Button Focusable="False" HorizontalAlignment="Stretch" Padding="8,6" Command="{Binding DiscardOriginalsCommand}" IsEnabled="{Binding HasFolder}" ToolTip.Tip="{l:Tr SaveChangesTip}">
                <c:IconLabel Icon="{x:Static s:Icons.Delete}" Text="{l:Tr SaveChanges}" />
              </Button>
              <Button Grid.Column="2" Focusable="False" HorizontalAlignment="Stretch" Padding="8,6" Command="{Binding RestoreOriginalCommand}" IsEnabled="{Binding HasSelection}" ToolTip.Tip="{l:Tr RestoreTip}">
                <c:IconLabel Icon="{x:Static s:Icons.Restore}" Text="{l:Tr RestoreOriginal}" />
              </Button>
            </Grid>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>

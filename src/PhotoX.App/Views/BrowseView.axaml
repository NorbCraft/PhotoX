<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PhotoX.App.ViewModels"
             xmlns:l="using:PhotoX.App.Localization"
             xmlns:s="using:PhotoX.App.Services"
             xmlns:v="using:PhotoX.App.Views"
             x:Class="PhotoX.App.Views.BrowseView"
             x:DataType="vm:BrowseViewModel">
  <Grid ColumnDefinitions="290,*,Auto">

    <!-- Explorer (FR-001), the same control as in ID Photos and Collages (prompt_04 §6) -->
    <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
      <v:ExplorerView DataContext="{Binding Explorer}" />
    </Border>

    <!-- Gallery (FR-002) -->
    <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*">
      <StackPanel Margin="24,16,24,8" Spacing="12">
        <TextBlock Text="{Binding CurrentFolder}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="chip" Focusable="False" Classes.selected="{Binding Filter, Converter={x:Static s:EqualsConverter.Instance}, ConverterParameter=All}"
                  Command="{Binding SetFilterCommand}" CommandParameter="{x:Static vm:PhotoFilter.All}">
            <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{l:Tr FilterAll}" /><TextBlock Text="{Binding CountAll}" Opacity="0.7" /></StackPanel>
          </Button>
          <Button Classes="chip" Focusable="False" Classes.selected="{Binding Filter, Converter={x:Static s:EqualsConverter.Instance}, ConverterParameter=ToDo}"
                  Command="{Binding SetFilterCommand}" CommandParameter="{x:Static vm:PhotoFilter.ToDo}">
            <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{l:Tr FilterToDo}" /><TextBlock Text="{Binding CountToDo}" Opacity="0.7" /></StackPanel>
          </Button>
          <Button Classes="chip" Focusable="False" Classes.selected="{Binding Filter, Converter={x:Static s:EqualsConverter.Instance}, ConverterParameter=Done}"
                  Command="{Binding SetFilterCommand}" CommandParameter="{x:Static vm:PhotoFilter.Done}">
            <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{l:Tr FilterDone}" /><TextBlock Text="{Binding CountDone}" Opacity="0.7" /></StackPanel>
          </Button>
        </StackPanel>
      </StackPanel>
      <Border Grid.Row="1" IsVisible="{Binding IsRemovable}" Margin="24,0,24,8" Background="#3A2C10" BorderBrush="#7A5714" BorderThickness="1" CornerRadius="8" Padding="12,8">
        <TextBlock Text="{l:Tr RemovableWarning}" Foreground="#F8D48A" TextWrapping="Wrap" />
      </Border>
      <TextBlock Grid.Row="2" IsVisible="{Binding !HasFolder}" Text="{l:Tr NoFolder}" Classes="muted" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
      <TextBlock Grid.Row="2" IsVisible="{Binding IsEmpty}" Text="{l:Tr NoPhotos}" Classes="muted" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
      <TextBlock Grid.Row="2" IsVisible="{Binding IsScanning}" Text="{l:Tr Loading}" Classes="muted" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
      <!-- Ctrl + click and Shift + click select several photos; Ctrl + A selects all (prompt_05 §5) -->
      <ListBox Grid.Row="2" x:Name="Gallery" Margin="16,0,8,8" Background="Transparent" ItemsSource="{Binding VisiblePhotos}" SelectedItem="{Binding SelectedPhoto}"
               SelectionMode="Multiple" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="CornerRadius" Value="9" />
          </Style>
          <Style Selector="ListBoxItem:selected /template/ ContentPresenter, ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
          </Style>
          <!-- Card look lives in styles (not local values), so the selected style can override it. -->
          <Style Selector="Border.card">
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Background" Value="#11FFFFFF" />
          </Style>
          <!-- The selected photo is clearly marked (prompt_03 §2) -->
          <Style Selector="ListBoxItem:selected Border.card">
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Background" Value="{StaticResource AccentTintBrush}" />
            <Setter Property="BorderThickness" Value="3" />
            <Setter Property="BoxShadow" Value="0 0 0 3 #553B82F6" />
          </Style>
          <Style Selector="ListBoxItem:selected TextBlock.name">
            <Setter Property="Foreground" Value="#D6E6FF" />
          </Style>
          <Style Selector="ListBoxItem:pointerover Border.card">
            <Setter Property="BorderBrush" Value="{StaticResource Border2Brush}" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:PhotoItemViewModel">
            <Border Classes="card" Width="176" Height="188" CornerRadius="9" DoubleTapped="OnPhotoDoubleTapped">
              <Border.ContextMenu>
                <!-- Right-click actions (prompt_04 §4) -->
                <ContextMenu>
                  <MenuItem Header="{l:Tr EditSelected}" IsEnabled="{Binding IsOpenable}" Click="OnEditClick" />
                  <MenuItem Header="{l:Tr UseForId}" IsEnabled="{Binding IsOpenable}" Click="OnUseForIdClick" />
                  <MenuItem Header="{l:Tr PrintMenu}" IsEnabled="{Binding IsOpenable}" Click="OnPrintClick" />
                  <Separator />
                  <MenuItem Header="{l:Tr DuplicateImage}" Click="OnDuplicateClick" />
                  <MenuItem Header="{l:Tr RestoreOriginal}" IsEnabled="{Binding IsOpenable}" Click="OnRestoreClick" />
                </ContextMenu>
              </Border.ContextMenu>
              <Grid RowDefinitions="132,*" Margin="8">
                <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                <TextBlock Text="…" IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNull}}" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Border IsVisible="{Binding HasBadge}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4" CornerRadius="10" Padding="7,1"
                        Background="{Binding IsWarning, Converter={x:Static s:IconConverter.BadgeBrush}}">
                  <TextBlock Text="{Binding IsWarning, Converter={x:Static s:IconConverter.BadgeGlyph}}" FontWeight="Bold" FontSize="12" Foreground="#151515" />
                </Border>
                <!-- Print counter (prompt_05 §6): copies accepted by Windows through PhotoX -->
                <Border Classes="printcount" Classes.printed="{Binding IsPrinted}" ToolTip.Tip="{Binding PrintCountTip}">
                  <TextBlock Text="{Binding PrintCountText}" />
                </Border>
                <StackPanel Grid.Row="1" Margin="2,8,2,0" Spacing="2">
                  <TextBlock Classes="name" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding StateText}" FontSize="11.5" IsVisible="{Binding HasBadge}" Foreground="{Binding IsWarning, Converter={x:Static s:IconConverter.StateBrush}}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Info}" FontSize="11.5" IsVisible="{Binding !HasBadge}" Foreground="{StaticResource Text3Brush}" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>

    <!-- Details (collapsible, FR-039) -->
    <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
      <!-- The actions always show; the photo preview and progress fold away (FR-039) -->
      <Panel>
        <Grid Width="330" RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="20,16,20,20">
          <Button Classes="list" Focusable="False" Padding="0,2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding ToggleDetailsCommand}" ToolTip.Tip="{l:Tr Details}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Classes="section" Text="{l:Tr SelectedPhoto}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding DetailsCollapsed, Converter={x:Static s:IconConverter.Chevron}}" Foreground="{StaticResource Text3Brush}" FontSize="11" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <StackPanel Grid.Row="1" Spacing="6" Margin="0,10,0,0" IsVisible="{Binding HasSelection}">
            <Border Background="{StaticResource CanvasBrush}" CornerRadius="8" Height="190" Padding="6" IsVisible="{Binding !DetailsCollapsed}">
              <Image Source="{Binding SelectedPhoto.Thumbnail}" Stretch="Uniform" />
            </Border>
            <TextBlock Text="{Binding SelectionText}" IsVisible="{Binding HasMultipleSelection}" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
            <StackPanel IsVisible="{Binding !HasMultipleSelection}" Spacing="4">
              <TextBlock Text="{Binding SelectedPhoto.Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,8,0,0" />
              <TextBlock Text="{Binding SelectedPhoto.Info}" Classes="muted" />
              <TextBlock Classes="muted"><Run Text="{Binding SelectedPhoto.StateText}" /><Run Text="  ·  " /><Run Text="{Binding SelectedPhoto.PrintCountTip}" /></TextBlock>
              <TextBlock Text="{Binding SelectedPhoto.ErrorText}" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" IsVisible="{Binding SelectedPhoto.ErrorText, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Row="2" Spacing="8" Margin="0,20,0,0" IsVisible="{Binding !DetailsCollapsed}">
            <TextBlock Classes="section" Text="{l:Tr OrderProgress}" />
            <TextBlock Text="{Binding ProgressText}" FontSize="18" FontWeight="SemiBold" />
            <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" />
            <TextBlock Text="{Binding PhotosLeftText}" Classes="muted" FontSize="12.5" />
          </StackPanel>
          <!-- Actions (prompt_05 §5): print, edit or use one photo, save or restore the selection -->
          <StackPanel Grid.Row="4" Spacing="8">
            <Grid ColumnDefinitions="*,8,*">
              <Button Classes="primary" Focusable="False" HorizontalAlignment="Stretch" MinHeight="46" Command="{Binding PrintSelectedCommand}" IsEnabled="{Binding HasSelection}">
                <TextBlock Text="{l:Tr PrintSelected}" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" />
              </Button>
              <Button Grid.Column="2" Focusable="False" HorizontalAlignment="Stretch" MinHeight="46" Command="{Binding PrintAllCommand}" IsEnabled="{Binding HasFolder}" Content="{l:Tr PrintAll}" />
            </Grid>
            <Button Focusable="False" HorizontalAlignment="Stretch" Command="{Binding EditPhotoCommand}" IsEnabled="{Binding HasSingleSelection}">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{l:Tr EditSelected}" HorizontalAlignment="Center" />
                <Border Grid.Column="1" Classes="kbd" Margin="8,0,0,0"><TextBlock Text="Enter" /></Border>
              </Grid>
            </Button>
            <Button Focusable="False" HorizontalAlignment="Stretch" Command="{Binding UseForIdCommand}" IsEnabled="{Binding HasSingleSelection}" Content="{l:Tr UseForId}" />
            <Grid ColumnDefinitions="*,8,*">
              <Button Focusable="False" HorizontalAlignment="Stretch" Command="{Binding SaveChangesCommand}" IsEnabled="{Binding HasSelection}" Content="{l:Tr SaveChanges}" ToolTip.Tip="{l:Tr SaveChangesTip}" />
              <Button Grid.Column="2" Focusable="False" HorizontalAlignment="Stretch" Command="{Binding RestoreOriginalCommand}" IsEnabled="{Binding HasSelection}" Content="{l:Tr RestoreOriginal}" ToolTip.Tip="{l:Tr RestoreTip}" />
            </Grid>
            <TextBlock Text="{l:Tr SelectionHint}" Foreground="{StaticResource Text3Brush}" FontSize="11.5" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </Panel>
    </Border>
  </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PhotoX.App.ViewModels"
             xmlns:l="using:PhotoX.App.Localization"
             xmlns:s="using:PhotoX.App.Services"
             x:Class="PhotoX.App.Views.BrowseView"
             x:DataType="vm:BrowseViewModel">
  <Grid ColumnDefinitions="290,*,Auto">

    <!-- Explorer (FR-001) -->
    <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,Auto,*,Auto">
        <StackPanel Margin="10,16,10,0" Spacing="2">
          <TextBlock Classes="section" Text="{l:Tr Locations}" Margin="8,0,0,6" />
          <ItemsControl ItemsSource="{Binding Locations}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:LocationItem">
                <Button Classes="list" Focusable="False"
                        Command="{Binding $parent[UserControl].((vm:BrowseViewModel)DataContext).SelectLocationCommand}" CommandParameter="{Binding}">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Path Data="{Binding IsRemovable, Converter={x:Static s:IconConverter.Drive}}" Stroke="{StaticResource Text2Brush}" StrokeThickness="1.8" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="10,18,10,0" Spacing="2" IsVisible="{Binding RecentFolders.Count}">
          <TextBlock Classes="section" Text="{l:Tr RecentFolders}" Margin="8,0,0,6" />
          <ItemsControl ItemsSource="{Binding RecentFolders}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <Button Classes="list" Focusable="False" ToolTip.Tip="{Binding}"
                        Command="{Binding $parent[UserControl].((vm:BrowseViewModel)DataContext).OpenRecentCommand}" CommandParameter="{Binding}">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Path Data="{x:Static s:IconConverter.ClockGeometry}" Stroke="{StaticResource Text2Brush}" StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Converter={x:Static s:IconConverter.FolderName}}" FontSize="14" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <DockPanel Grid.Row="2" Margin="10,18,10,8">
          <TextBlock DockPanel.Dock="Top" Classes="section" Text="{l:Tr Folders}" Margin="8,0,0,6" />
          <TreeView ItemsSource="{Binding FolderRoots}" SelectedItem="{Binding SelectedFolderNode}" Background="Transparent">
            <TreeView.Styles>
              <Style Selector="TreeViewItem" x:DataType="vm:FolderNodeViewModel">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                <Setter Property="MinHeight" Value="30" />
              </Style>
            </TreeView.Styles>
            <TreeView.ItemTemplate>
              <TreeDataTemplate x:DataType="vm:FolderNodeViewModel" ItemsSource="{Binding Children}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Path Data="{x:Static s:IconConverter.FolderGeometry}" Stroke="{StaticResource Text2Brush}" StrokeThickness="1.6" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Name}" FontSize="13.5" />
                </StackPanel>
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </DockPanel>
        <TextBlock Grid.Row="3" Margin="18,6,18,14" Text="{l:Tr OriginalsNote}" FontSize="12" Foreground="{StaticResource Text3Brush}" TextWrapping="Wrap" />
      </Grid>
    </Border>

    <!-- Gallery (FR-002) -->
    <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*">
      <StackPanel Margin="24,16,24,8" Spacing="12">
        <TextBlock Text="{Binding CurrentFolder}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="chip" Focusable="False" Classes.selected="{Binding Filter, Converter={x:Static s:EqualsConverter.Instance}, ConverterParameter=All}"
                  Command="{Binding SetFilterCommand}" CommandParameter="{x:Static vm:PhotoFilter.All}">
            <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{l:Tr FilterAll}" /><TextBlock Text="{Binding CountAll}" Opacity="0.7" /></StackPanel>
          </Button>
          <Button Classes="chip" Focusable="False" Classes.selected="{Binding Filter, Converter={x:Static s:EqualsConverter.Instance}, ConverterParameter=ToDo}"
                  Command="{Binding SetFilterCommand}" CommandParameter="{x:Static vm:PhotoFilter.ToDo}">
            <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{l:Tr FilterToDo}" /><TextBlock Text="{Binding CountToDo}" Opacity="0.7" /></StackPanel>
          </Button>
          <Button Classes="chip" Focusable="False" Classes.selected="{Binding Filter, Converter={x:Static s:EqualsConverter.Instance}, ConverterParameter=Done}"
                  Command="{Binding SetFilterCommand}" CommandParameter="{x:Static vm:PhotoFilter.Done}">
            <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{l:Tr FilterDone}" /><TextBlock Text="{Binding CountDone}" Opacity="0.7" /></StackPanel>
          </Button>
        </StackPanel>
      </StackPanel>
      <Border Grid.Row="1" IsVisible="{Binding IsRemovable}" Margin="24,0,24,8" Background="#3A2C10" BorderBrush="#7A5714" BorderThickness="1" CornerRadius="8" Padding="12,8">
        <TextBlock Text="{l:Tr RemovableWarning}" Foreground="#F8D48A" TextWrapping="Wrap" />
      </Border>
      <TextBlock Grid.Row="2" IsVisible="{Binding !HasFolder}" Text="{l:Tr NoFolder}" Classes="muted" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
      <TextBlock Grid.Row="2" IsVisible="{Binding IsEmpty}" Text="{l:Tr NoPhotos}" Classes="muted" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
      <ListBox Grid.Row="2" x:Name="Gallery" Margin="16,0,8,8" Background="Transparent" ItemsSource="{Binding VisiblePhotos}" SelectedItem="{Binding SelectedPhoto}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="CornerRadius" Value="9" />
          </Style>
          <Style Selector="ListBoxItem:selected /template/ ContentPresenter, ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
          </Style>
          <Style Selector="ListBoxItem:selected Border.card">
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Background" Value="{StaticResource AccentTintBrush}" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:PhotoItemViewModel">
            <Border Classes="card" Width="176" Height="188" CornerRadius="9" BorderThickness="2" BorderBrush="{StaticResource BorderBrush}" Background="#11FFFFFF"
                    DoubleTapped="OnPhotoDoubleTapped">
              <Grid RowDefinitions="132,*" Margin="8">
                <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                <TextBlock Text="…" IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNull}}" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Border IsVisible="{Binding HasBadge}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4" CornerRadius="10" Padding="7,1"
                        Background="{Binding IsWarning, Converter={x:Static s:IconConverter.BadgeBrush}}">
                  <TextBlock Text="{Binding IsWarning, Converter={x:Static s:IconConverter.BadgeGlyph}}" FontWeight="Bold" FontSize="12" Foreground="#151515" />
                </Border>
                <StackPanel Grid.Row="1" Margin="2,8,2,0" Spacing="2">
                  <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding StateText}" FontSize="11.5" IsVisible="{Binding HasBadge}" Foreground="{Binding IsWarning, Converter={x:Static s:IconConverter.StateBrush}}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Info}" FontSize="11.5" IsVisible="{Binding !HasBadge}" Foreground="{StaticResource Text3Brush}" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>

    <!-- Details (collapsible, FR-039) -->
    <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
      <Panel>
        <Button IsVisible="{Binding DetailsCollapsed}" Classes="list" Focusable="False" VerticalAlignment="Top" Margin="6,12" Width="36"
                Command="{Binding ToggleDetailsCommand}" ToolTip.Tip="{l:Tr Details}" Content="‹" FontSize="20" />
        <Grid IsVisible="{Binding !DetailsCollapsed}" Width="330" RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="20,16,20,20">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="section" Text="{l:Tr SelectedPhoto}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="list" Focusable="False" Padding="8,0" Command="{Binding ToggleDetailsCommand}" ToolTip.Tip="{l:Tr HideDetails}" Content="›" FontSize="20" />
          </Grid>
          <StackPanel Grid.Row="1" Spacing="6" Margin="0,10,0,0" IsVisible="{Binding HasSelection}">
            <Border Background="{StaticResource CanvasBrush}" CornerRadius="8" Height="210" Padding="6">
              <Image Source="{Binding SelectedPhoto.Thumbnail}" Stretch="Uniform" />
            </Border>
            <TextBlock Text="{Binding SelectedPhoto.Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,8,0,0" />
            <TextBlock Text="{Binding SelectedPhoto.Info}" Classes="muted" />
            <TextBlock Text="{Binding SelectedPhoto.StateText}" Classes="muted" />
            <TextBlock Text="{Binding SelectedPhoto.ErrorText}" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" IsVisible="{Binding SelectedPhoto.ErrorText, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
          <StackPanel Grid.Row="2" Spacing="8" Margin="0,24,0,0" IsVisible="{Binding HasFolder}">
            <TextBlock Classes="section" Text="{l:Tr OrderProgress}" />
            <TextBlock Text="{Binding ProgressText}" FontSize="18" FontWeight="SemiBold" />
            <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" />
            <TextBlock Text="{Binding PhotosLeftText}" Classes="muted" FontSize="12.5" />
          </StackPanel>
          <StackPanel Grid.Row="4" Spacing="10">
            <Button Classes="primary" Focusable="False" HorizontalAlignment="Stretch" MinHeight="62" Command="{Binding StartEditingCommand}" IsEnabled="{Binding HasFolder}">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel HorizontalAlignment="Center">
                  <TextBlock Text="{l:Tr StartEditing}" FontSize="16" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" />
                  <TextBlock Text="{l:Tr StartEditingHint}" FontSize="11.5" Foreground="White" Opacity="0.8" HorizontalAlignment="Center" />
                </StackPanel>
                <Border Grid.Column="1" Classes="kbd" Margin="8,0,0,0"><TextBlock Text="Enter" Foreground="White" /></Border>
              </Grid>
            </Button>
            <Button Focusable="False" HorizontalAlignment="Stretch" Command="{Binding EditPhotoCommand}" CommandParameter="{Binding SelectedPhoto}" IsEnabled="{Binding HasSelection}" Content="{l:Tr EditSelected}" />
            <Button Focusable="False" HorizontalAlignment="Stretch" Command="{Binding FinishOrderCommand}" IsEnabled="{Binding HasFolder}" Content="{l:Tr FinishOrder}" />
          </StackPanel>
        </Grid>
      </Panel>
    </Border>
  </Grid>
</UserControl>

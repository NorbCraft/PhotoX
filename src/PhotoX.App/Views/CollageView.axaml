<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PhotoX.App.ViewModels"
             xmlns:l="using:PhotoX.App.Localization"
             xmlns:c="using:PhotoX.App.Controls"
             xmlns:v="using:PhotoX.App.Views"
             xmlns:s="using:PhotoX.App.Services"
             x:Class="PhotoX.App.Views.CollageView"
             x:DataType="vm:CollageViewModel">
  <UserControl.Styles>
    <Style Selector="Button.template">
      <Setter Property="Padding" Value="6" />
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="Background" Value="{DynamicResource Panel2Brush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Button.template.selected">
      <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
  </UserControl.Styles>
  <!-- Collages (prompt_04 §5): Select photos → Choose template → Arrange → Save JPG -->
  <Grid x:Name="Root" ColumnDefinitions="300,Auto,*,Auto,320">

    <!-- 1. Photos: the built-in explorer and the folder's thumbnails (prompt_04 §6); drag a photo into a frame (prompt_06 §6) -->
    <Border Background="{DynamicResource PanelBrush}">
      <Grid RowDefinitions="1.25*,5,*">
        <v:ExplorerView DataContext="{Binding Picker.Explorer}" />
        <GridSplitter Grid.Row="1" ResizeDirection="Rows" Background="{DynamicResource BorderBrush}" />
        <DockPanel Grid.Row="2">
          <StackPanel DockPanel.Dock="Top" Margin="18,10,14,4" Spacing="2">
            <TextBlock Classes="section" Text="{l:Tr CollagePhotos}" />
            <TextBlock Text="{l:Tr CollagePickHint}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>
          <Button DockPanel.Dock="Bottom" Margin="12,4,12,12" HorizontalAlignment="Stretch" Focusable="False" Command="{Binding Picker.PickCommand}">
            <c:IconLabel Icon="{x:Static s:Icons.FrameAdd}" Text="{l:Tr AddToFrame}" />
          </Button>
          <v:PickerGrid Margin="8,0" DataContext="{Binding Picker}" />
        </DockPanel>
      </Grid>
    </Border>

    <GridSplitter Grid.Column="1" Classes="panel" ResizeDirection="Columns" DragCompleted="OnLeftSplitterDragCompleted" />

    <!-- 3. Arrange: the whole collage in true proportions; right-click a photo for its menu (prompt_06 §6) -->
    <Panel Grid.Column="2" Background="{DynamicResource CanvasBrush}">
      <c:CollageCanvas x:Name="Canvas" Scene="{Binding Scene}" Margin="8,8,8,40">
        <c:CollageCanvas.ContextMenu>
          <ContextMenu Opening="OnSlotMenuOpening">
            <MenuItem Header="{l:Tr RotateLeft90}" Command="{Binding RotateLeftCommand}">
              <MenuItem.Icon><Path Data="{x:Static s:Icons.RotateLeft}" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.6" StrokeLineCap="Round" Width="24" Height="24" Stretch="None" RenderTransform="scale(0.75)" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{l:Tr RotateRight90}" Command="{Binding RotateRightCommand}">
              <MenuItem.Icon><Path Data="{x:Static s:Icons.RotateRight}" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.6" StrokeLineCap="Round" Width="24" Height="24" Stretch="None" RenderTransform="scale(0.75)" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="{l:Tr FitPhoto}" Command="{Binding FitPhotoCommand}">
              <MenuItem.Icon><Path Classes="bi" Data="{x:Static s:Icons.ResetCrop}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{l:Tr RemovePhoto}" Command="{Binding RemovePhotoCommand}">
              <MenuItem.Icon><Path Classes="bi" Data="{x:Static s:Icons.FrameRemove}" /></MenuItem.Icon>
            </MenuItem>
          </ContextMenu>
        </c:CollageCanvas.ContextMenu>
      </c:CollageCanvas>
      <TextBlock Text="{l:Tr CollageHint}" Classes="muted" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="16,0,16,8"
                 TextWrapping="Wrap" TextAlignment="Center" MaxWidth="720" />
      <Border IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" Background="{DynamicResource ErrorBgBrush}" BorderBrush="{DynamicResource ErrorBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10"
              Margin="24" HorizontalAlignment="Center" VerticalAlignment="Top" MaxWidth="700">
        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorTextBrush}" TextWrapping="Wrap" />
      </Border>
      <Border IsVisible="{Binding IsBusy}" Background="#A0000000" CornerRadius="8" Padding="16,8" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="{l:Tr Saving}" Foreground="White" FontSize="14" />
      </Border>
    </Panel>

    <GridSplitter Grid.Column="3" Classes="panel" ResizeDirection="Columns" DragCompleted="OnRightSplitterDragCompleted" />

    <!-- 2. Sheet and template; then save or print -->
    <Border Grid.Column="4" Background="{DynamicResource PanelBrush}">
      <Grid RowDefinitions="*,Auto">
        <ScrollViewer Padding="18,16,18,8">
          <StackPanel Spacing="8">
            <TextBlock Classes="section" Text="{l:Tr Sheet}" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Classes="chip compact" Focusable="False" Content="10 × 15" Command="{Binding SetSheetCommand}" CommandParameter="10x15"
                      Classes.selected="{Binding Sheet.Id, Converter={x:Static s:EqualsConverter.Instance}, ConverterParameter=10x15}" />
              <Button Classes="chip compact" Focusable="False" Content="15 × 20" Command="{Binding SetSheetCommand}" CommandParameter="15x20"
                      Classes.selected="{Binding Sheet.Id, Converter={x:Static s:EqualsConverter.Instance}, ConverterParameter=15x20}" />
            </StackPanel>
            <Border Classes="segbox" HorizontalAlignment="Left">
              <StackPanel Orientation="Horizontal">
                <ToggleButton Classes="segacc icon large" Focusable="False" IsChecked="{Binding !IsLandscape, Mode=OneWay}" ToolTip.Tip="{l:Tr Portrait}"
                              Command="{Binding SetLandscapeCommand}" CommandParameter="{x:False}">
                  <Rectangle Width="14" Height="21" StrokeThickness="2" RadiusX="2" RadiusY="2" />
                </ToggleButton>
                <ToggleButton Classes="segacc icon large" Focusable="False" IsChecked="{Binding IsLandscape, Mode=OneWay}" ToolTip.Tip="{l:Tr Landscape}"
                              Command="{Binding SetLandscapeCommand}" CommandParameter="{x:True}">
                  <Rectangle Width="21" Height="14" StrokeThickness="2" RadiusX="2" RadiusY="2" />
                </ToggleButton>
              </StackPanel>
            </Border>
            <TextBlock Text="{Binding PageText}" Classes="muted" FontSize="12" TextWrapping="Wrap" />

            <TextBlock Classes="section" Text="{l:Tr Template}" Margin="0,10,0,0" />
            <ItemsControl ItemsSource="{Binding Templates}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CollageTemplateItem">
                  <Button Classes="template" Classes.selected="{Binding IsSelected}" Focusable="False"
                          Command="{Binding $parent[UserControl].((vm:CollageViewModel)DataContext).SetTemplateCommand}" CommandParameter="{Binding}">
                    <Border Background="White" CornerRadius="2"
                            Width="{Binding $parent[UserControl].((vm:CollageViewModel)DataContext).TemplateIconWidth}"
                            Height="{Binding $parent[UserControl].((vm:CollageViewModel)DataContext).TemplateIconHeight}">
                      <Path Data="{Binding Drawing}" Fill="#8E9AAF" />
                    </Border>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid ColumnDefinitions="*,120" Margin="0,4,0,0">
              <TextBlock Text="{l:Tr CollageSpacing}" VerticalAlignment="Center" />
              <NumericUpDown Grid.Column="1" Value="{Binding SpacingMm}" Minimum="0" Maximum="10" Increment="0.5" FormatString="0.#" />
            </Grid>

            <TextBlock Classes="section" Text="{l:Tr CollageFrames}" Margin="0,10,0,0" />
            <TextBlock Text="{Binding FilledText}" Classes="muted" />
            <!-- The selected frame's size; typing changes its column or row, the sheet stays filled (prompt_05 §8) -->
            <TextBlock Text="{l:Tr SelectedFrameSize}" FontWeight="SemiBold" Margin="0,4,0,0" />
            <Grid ColumnDefinitions="*,Auto,*,Auto">
              <NumericUpDown Value="{Binding SlotWidthCm}" IsEnabled="{Binding CanResizeWidth}" Minimum="1" Maximum="20" Increment="0.5" FormatString="0.0" ToolTip.Tip="{l:Tr Width}" />
              <TextBlock Grid.Column="1" Text="×" Margin="6,0" VerticalAlignment="Center" />
              <NumericUpDown Grid.Column="2" Value="{Binding SlotHeightCm}" IsEnabled="{Binding CanResizeHeight}" Minimum="1" Maximum="20" Increment="0.5" FormatString="0.0" ToolTip.Tip="{l:Tr Height}" />
              <TextBlock Grid.Column="3" Text="cm" Margin="6,0,0,0" VerticalAlignment="Center" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{l:Tr LayoutHint}" Classes="muted" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="link" Focusable="False" Content="{l:Tr ResetLayout}" Command="{Binding ResetLayoutCommand}" VerticalAlignment="Center" />
            </Grid>
            <Grid ColumnDefinitions="*,8,*">
              <Button Focusable="False" HorizontalAlignment="Stretch" Padding="8,6" Command="{Binding RemovePhotoCommand}" IsEnabled="{Binding SelectedHasPhoto}">
                <c:IconLabel Icon="{x:Static s:Icons.FrameRemove}" Text="{l:Tr RemovePhoto}" />
              </Button>
              <Button Grid.Column="2" Focusable="False" HorizontalAlignment="Stretch" Padding="8,6" Command="{Binding ClearAllCommand}" IsEnabled="{Binding HasPhotos}">
                <c:IconLabel Icon="{x:Static s:Icons.Close}" Text="{l:Tr ClearAll}" />
              </Button>
            </Grid>

            <TextBlock Classes="section" Text="{l:Tr Output}" Margin="0,10,0,0" />
            <TextBlock Text="{l:Tr OutputFolder}" Classes="muted" FontSize="12" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding OutputFolderText}" ToolTip.Tip="{Binding OutputFolder}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontWeight="SemiBold" />
              <Button Grid.Column="1" Focusable="False" Command="{Binding ChangeOutputFolderCommand}" Margin="8,0,0,0" Padding="10,6,14,6">
                <c:IconLabel Icon="{x:Static s:Icons.Folder}" Text="{l:Tr Change}" />
              </Button>
            </Grid>
            <TextBlock Text="{l:Tr FileName}" Classes="muted" FontSize="12" Margin="0,6,0,0" />
            <TextBlock Text="{Binding FileNamePreview}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding StatusMessage}" Classes="ok" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
        <!-- Save and Print use the same composition (prompt_05 §8) -->
        <Grid Grid.Row="1" ColumnDefinitions="*,8,*" Margin="18,8,18,16">
          <Button Focusable="False" HorizontalAlignment="Stretch" MinHeight="52" Command="{Binding SaveCommand}" IsEnabled="{Binding HasPhotos}">
            <c:IconLabel Icon="{x:Static s:Icons.Save}" Text="{l:Tr SaveJpg}" TextElement.FontSize="15" />
          </Button>
          <Button Grid.Column="2" Classes="primary" Focusable="False" HorizontalAlignment="Stretch" MinHeight="52" Command="{Binding PrintCommand}" IsEnabled="{Binding HasPhotos}">
            <c:IconLabel Icon="{x:Static s:Icons.Printer}" Text="{l:Tr Print}" TextElement.FontSize="15" TextElement.FontWeight="SemiBold" />
          </Button>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:PhotoX.App.Controls"
             xmlns:vm="using:PhotoX.App.ViewModels"
             xmlns:l="using:PhotoX.App.Localization"
             xmlns:s="using:PhotoX.App.Services"
             x:Class="PhotoX.App.Views.EditActionsView"
             x:DataType="vm:ToneAdjustmentsViewModel">
  <!-- Top of the editing sidebar, the same in Photos and ID Photos (prompt_06 §1): Undo, Redo and one Reset for the
       image adjustments (the crop or framing stays) -->
  <Grid ColumnDefinitions="Auto,Auto,*,Auto">
    <Button Classes="icon" Focusable="False" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" ToolTip.Tip="{l:Tr UndoTip}" HorizontalAlignment="Left">
      <Path Data="{x:Static s:Icons.Undo}" />
    </Button>
    <Button Grid.Column="1" Classes="icon" Focusable="False" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}" ToolTip.Tip="{l:Tr RedoTip}" HorizontalAlignment="Left" Margin="6,0,0,0">
      <Path Data="{x:Static s:Icons.Redo}" />
    </Button>
    <Button Grid.Column="3" Focusable="False" Padding="12,4,14,4" Command="{Binding ResetAdjustmentsCommand}" ToolTip.Tip="{Binding ResetTip}" VerticalAlignment="Center">
      <c:IconLabel Icon="{x:Static s:Icons.Reset}" Text="{l:Tr Reset}" />
    </Button>
  </Grid>
</UserControl>

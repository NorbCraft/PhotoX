<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PhotoX.App.ViewModels"
             xmlns:v="using:PhotoX.App.Views"
             xmlns:l="using:PhotoX.App.Localization"
             xmlns:s="using:PhotoX.App.Services"
             xmlns:c="using:PhotoX.App.Controls"
             xmlns:g="using:PhotoX.Core.Geometry"
             xmlns:e="using:PhotoX.Core.Editing"
             x:Class="PhotoX.App.Views.EditorView"
             x:DataType="vm:EditorViewModel">
  <Grid x:Name="Root" ColumnDefinitions="*,Auto,340" RowDefinitions="Auto,*,Auto">

    <!-- Toolbar (FR-010, FR-012, FR-015, FR-049): fixed order; scrolls instead of wrapping when the window is narrow -->
    <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,7">
      <Grid ColumnDefinitions="*,Auto">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,2">
            <Button Classes="icon large" Focusable="False" Command="{Binding BackToFolderCommand}" ToolTip.Tip="{l:Tr BackToFolderTip}">
              <Path Data="{x:Static s:Icons.FolderBack}" />
            </Button>
            <Border Classes="sep" />
            <Button Classes="chip compact" Focusable="False" Content="10 × 15" Command="{Binding SetFormatCommand}" CommandParameter="10x15"
                    Classes.selected="{Binding FormatId, Converter={x:Static s:EqualsConverter.Instance}, ConverterParameter=10x15}" />
            <Button Classes="chip compact" Focusable="False" Content="15 × 20" Command="{Binding SetFormatCommand}" CommandParameter="15x20"
                    Classes.selected="{Binding FormatId, Converter={x:Static s:EqualsConverter.Instance}, ConverterParameter=15x20}" />
            <Button Classes="chip compact" Focusable="False" Content="9 × 13" Command="{Binding SetFormatCommand}" CommandParameter="9x13"
                    Classes.selected="{Binding FormatId, Converter={x:Static s:EqualsConverter.Instance}, ConverterParameter=9x13}" />
            <Button Classes="chip compact" Focusable="False" Content="13 × 18" Command="{Binding SetFormatCommand}" CommandParameter="13x18"
                    Classes.selected="{Binding FormatId, Converter={x:Static s:EqualsConverter.Instance}, ConverterParameter=13x18}" />
            <Button Classes="chip compact" Focusable="False" Content="{l:Tr Custom}"
                    Classes.selected="{Binding FormatId, Converter={x:Static s:EqualsConverter.Instance}, ConverterParameter=custom}">
              <Button.Flyout>
                <Flyout Placement="Bottom">
                  <StackPanel Spacing="10" Width="280">
                    <TextBlock Text="{l:Tr CustomPrintSize}" FontWeight="SemiBold" />
                    <Grid ColumnDefinitions="*,Auto,*,Auto">
                      <NumericUpDown Value="{Binding CustomWidth}" Minimum="1" Maximum="100" Increment="0.5" FormatString="0.#" ToolTip.Tip="{l:Tr Width}" />
                      <TextBlock Grid.Column="1" Text="×" VerticalAlignment="Center" Margin="8,0" />
                      <NumericUpDown Grid.Column="2" Value="{Binding CustomHeight}" Minimum="1" Maximum="100" Increment="0.5" FormatString="0.#" ToolTip.Tip="{l:Tr Height}" />
                      <TextBlock Grid.Column="3" Text="cm" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </Grid>
                    <TextBlock Text="{l:Tr CustomSizeHint}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                    <Button Classes="primary" HorizontalAlignment="Stretch" Content="{l:Tr Apply}" Command="{Binding ApplyCustomSizeCommand}" />
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
            <Border Classes="sep" />
            <Border Classes="segbox">
              <StackPanel Orientation="Horizontal">
                <ToggleButton Classes="segacc icon large" Focusable="False" IsChecked="{Binding IsPortrait, Mode=OneWay}" ToolTip.Tip="{l:Tr Portrait}"
                              Command="{Binding SetOrientationCommand}" CommandParameter="{x:Static g:CropOrientation.Portrait}">
                  <Rectangle Width="14" Height="21" StrokeThickness="2" RadiusX="2" RadiusY="2" />
                </ToggleButton>
                <ToggleButton Classes="segacc icon large" Focusable="False" IsChecked="{Binding !IsPortrait, Mode=OneWay}" ToolTip.Tip="{l:Tr Landscape}"
                              Command="{Binding SetOrientationCommand}" CommandParameter="{x:Static g:CropOrientation.Landscape}">
                  <Rectangle Width="21" Height="14" StrokeThickness="2" RadiusX="2" RadiusY="2" />
                </ToggleButton>
              </StackPanel>
            </Border>
            <Border Classes="sep" />
            <Border Classes="segbox">
              <StackPanel Orientation="Horizontal">
                <ToggleButton Classes="segacc" Focusable="False" IsChecked="{Binding !IsWholeWithBorder, Mode=OneWay}" Content="{l:Tr Fill}"
                              Command="{Binding SetCompositionCommand}" CommandParameter="{x:Static e:Composition.Fill}" />
                <ToggleButton Classes="segacc" Focusable="False" IsChecked="{Binding IsWholeWithBorder, Mode=OneWay}" Content="{l:Tr Borders}"
                              Command="{Binding SetCompositionCommand}" CommandParameter="{x:Static e:Composition.WholeWithBorder}" />
              </StackPanel>
            </Border>
            <Border Classes="sep" />
            <Button Classes="icon" Focusable="False" Command="{Binding RotateLeftCommand}" ToolTip.Tip="{l:Tr RotateLeft}">
              <Path Data="{x:Static s:Icons.RotateLeft}" />
            </Button>
            <Button Classes="icon" Focusable="False" Command="{Binding RotateRightCommand}" ToolTip.Tip="{l:Tr RotateRight}">
              <Path Data="{x:Static s:Icons.RotateRight}" />
            </Button>
            <!-- Straightening: icon, slider and the angle in one centred group (prompt_04 §7) -->
            <Border Classes="segbox" Padding="8,0,4,0" Height="34" ToolTip.Tip="{l:Tr StraightenTip}">
              <Grid ColumnDefinitions="Auto,Auto,Auto" VerticalAlignment="Center">
                <Path Data="{x:Static s:Icons.Straighten}" Stroke="{DynamicResource Text2Brush}" StrokeThickness="1.8" StrokeLineCap="Round" Width="24" Height="24" Stretch="None" VerticalAlignment="Center" />
                <Slider Grid.Column="1" Width="120" Margin="8,-14" Minimum="-10" Maximum="10" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding Straighten}"
                        VerticalAlignment="Center" DoubleTapped="OnStraightenDoubleTapped" />
                <Border Grid.Column="2" Background="{DynamicResource RaisedBrush}" CornerRadius="6" MinWidth="56" Height="26" VerticalAlignment="Center">
                  <TextBlock Text="{Binding StraightenText}" FontSize="13" FontWeight="SemiBold" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </Grid>
            </Border>
            <Border Classes="sep" />
            <Button Classes="icon" Focusable="False" Command="{Binding ResetCropCommand}" ToolTip.Tip="{l:Tr ResetCrop}">
              <Path Data="{x:Static s:Icons.ResetCrop}" />
            </Button>
            <ToggleButton Classes="segacc icon outlined" Focusable="False" IsChecked="{Binding CropApplied, Mode=OneWay}" Command="{Binding ToggleCropCommand}"
                          IsEnabled="{Binding !IsWholeWithBorder}" ToolTip.Tip="{l:Tr ApplyCropTip}">
              <Path Data="{x:Static s:Icons.Crop}" />
            </ToggleButton>
          </StackPanel>
        </ScrollViewer>
        <!-- Before / after: the original shows only while the button (or Space) is held (prompt_04 §7) -->
        <Button x:Name="BeforeButton" Grid.Column="1" Classes="icon hold" Focusable="False" ToolTip.Tip="{l:Tr BeforeAfterTip}" VerticalAlignment="Center" Margin="6,0,0,0">
          <Path Data="{x:Static s:Icons.BeforeAfter}" />
        </Button>
      </Grid>
    </Border>

    <!-- Canvas -->
    <Panel Grid.Row="1" Grid.Column="0" Background="{DynamicResource CanvasBrush}">
      <c:PhotoCanvas x:Name="Canvas" Source="{Binding Preview}" ContentSize="{Binding PreviewSize}" Angle="{Binding Straighten}"
                     CropRect="{Binding CropRect}" CropRatio="{Binding CropRatio}" CropBounds="{Binding CropBounds}" ShowCrop="{Binding ShowCrop}"
                     ShowResult="{Binding ShowResult}" ResultFrame="{Binding ResultFrame}" ResultCrop="{Binding ResultCrop}" />
      <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18,14" Spacing="6">
        <Border Background="#B0000000" CornerRadius="14" Padding="12,5" IsVisible="{Binding Preview, Converter={x:Static ObjectConverters.IsNotNull}}">
          <TextBlock Text="{Binding CropInfo}" FontWeight="SemiBold" FontSize="13" Foreground="White" />
        </Border>
        <Border Background="{DynamicResource WarnBgBrush}" BorderBrush="{DynamicResource WarnBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="12,4" IsVisible="{Binding ResolutionWarning, Converter={x:Static ObjectConverters.IsNotNull}}">
          <TextBlock Text="{Binding ResolutionWarning}" Foreground="{DynamicResource WarnTextBrush}" FontSize="12.5" />
        </Border>
      </StackPanel>
      <Border IsVisible="{Binding IsLoading}" Background="#A0000000" CornerRadius="8" Padding="16,8" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="{l:Tr Loading}" Foreground="White" FontSize="14" />
      </Border>
      <Border IsVisible="{Binding IsSaving}" Background="#A0000000" CornerRadius="8" Padding="16,8" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="{l:Tr Saving}" Foreground="White" FontSize="14" />
      </Border>
      <Border IsVisible="{Binding HasError}" Background="{DynamicResource ErrorBgBrush}" BorderBrush="{DynamicResource ErrorBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="24"
              HorizontalAlignment="Center" VerticalAlignment="Bottom" MaxWidth="760">
        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorTextBrush}" TextWrapping="Wrap" FontSize="14" />
      </Border>
    </Panel>

    <!-- Filmstrip and progress -->
    <Border Grid.Row="2" Grid.Column="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,8">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="14" Margin="0,0,0,6">
          <TextBlock Text="{Binding PositionText}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
          <ProgressBar Width="160" Minimum="0" Maximum="1" Value="{Binding Browse.Progress}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Browse.ProgressText}" Classes="muted" VerticalAlignment="Center" />
          <TextBlock Text="{Binding StatusMessage}" Classes="muted" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="FilmStrip" ItemsSource="{Binding Browse.AllPhotos}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><VirtualizingStackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PhotoItemViewModel">
                <Button Classes="film" Classes.current="{Binding IsCurrent}" Focusable="False" Padding="2" Width="96" Height="74" CornerRadius="5" Margin="0,0,8,0"
                        Command="{Binding $parent[UserControl].((vm:EditorViewModel)DataContext).OpenItemCommand}" CommandParameter="{Binding}" ToolTip.Tip="{Binding Name}">
                  <Panel>
                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                    <Border IsVisible="{Binding HasBadge}" HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="8" Padding="5,0" Margin="2"
                            Background="{Binding IsWarning, Converter={x:Static s:IconConverter.BadgeBrush}}">
                      <TextBlock Text="{Binding IsWarning, Converter={x:Static s:IconConverter.BadgeGlyph}}" FontWeight="Bold" FontSize="10.5" Foreground="#151515" />
                    </Border>
                  </Panel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Resizable settings panel (prompt_03 §3) -->
    <GridSplitter Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Classes="panel" ResizeDirection="Columns" DragCompleted="OnSplitterDragCompleted" />

    <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="2" Background="{DynamicResource PanelBrush}">
      <Grid RowDefinitions="Auto,*,Auto">
        <v:EditActionsView DataContext="{Binding Tone}" Margin="14,10,18,0" />
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" Padding="18,6,18,8">
          <v:ToneAdjustmentsView DataContext="{Binding Tone}" />
        </ScrollViewer>
        <!-- Actions (prompt_07 §1.5): Close, Print and Save, then Save & Next; shortcuts in the tooltips -->
        <StackPanel Grid.Row="2" Spacing="8" Margin="18,8,18,16">
          <Grid ColumnDefinitions="*,8,*,8,*">
            <Button Focusable="False" HorizontalAlignment="Stretch" Padding="4,6" Command="{Binding BackToFolderCommand}" ToolTip.Tip="{l:Tr CloseEditorTip}">
              <c:IconLabel Icon="{x:Static s:Icons.Close}" Text="{l:Tr Close}" />
            </Button>
            <Button Grid.Column="2" Focusable="False" HorizontalAlignment="Stretch" Padding="4,6" Command="{Binding PrintCommand}" IsEnabled="{Binding !IsBusy}" ToolTip.Tip="{l:Tr PrintEditedTip}">
              <c:IconLabel Icon="{x:Static s:Icons.Printer}" Text="{l:Tr Print}" />
            </Button>
            <Button Grid.Column="4" Focusable="False" HorizontalAlignment="Stretch" Padding="4,6" Command="{Binding SaveCommand}" IsEnabled="{Binding !IsBusy}" ToolTip.Tip="{l:Tr SaveTip}">
              <c:IconLabel Icon="{x:Static s:Icons.Save}" Text="{l:Tr Save}" />
            </Button>
          </Grid>
          <Button Classes="primary" Focusable="False" HorizontalAlignment="Stretch" MinHeight="56" Command="{Binding SaveAndNextCommand}" IsEnabled="{Binding !IsBusy}">
            <StackPanel Classes="bs">
              <Path Classes="bi" Data="{x:Static s:Icons.SaveNext}" IsVisible="{Binding !IsCloseMode}" />
              <Path Classes="bi" Data="{x:Static s:Icons.Close}" IsVisible="{Binding IsCloseMode}" />
              <TextBlock IsVisible="{Binding !IsCloseMode}" Text="{l:Tr SaveAndNext}" FontSize="17" FontWeight="SemiBold" Foreground="White" />
              <TextBlock IsVisible="{Binding IsCloseMode}" Text="{l:Tr Close}" FontSize="17" FontWeight="SemiBold" Foreground="White" />
              <Border Classes="kbd" Margin="4,0,0,0"><TextBlock Text="Enter" Foreground="White" /></Border>
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>

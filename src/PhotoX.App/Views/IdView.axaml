<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PhotoX.App.ViewModels"
             xmlns:l="using:PhotoX.App.Localization"
             xmlns:c="using:PhotoX.App.Controls"
             xmlns:v="using:PhotoX.App.Views"
             x:Class="PhotoX.App.Views.IdView"
             x:DataType="vm:IdViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.label"><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="FontSize" Value="13" /></Style>
    <Style Selector="TextBlock.value"><Setter Property="Foreground" Value="{StaticResource Text2Brush}" /><Setter Property="FontSize" Value="12.5" /><Setter Property="HorizontalAlignment" Value="Right" /></Style>
    <Style Selector="Slider:not(.tone)"><Setter Property="Margin" Value="0,-8,0,-6" /></Style>
    <Style Selector="Button.size">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="Background" Value="{StaticResource Panel2Brush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    </Style>
    <Style Selector="ToggleButton.step">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Padding" Value="16,7" />
      <Setter Property="MinHeight" Value="38" />
    </Style>
    <Style Selector="Border.stepnum">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="#33FFFFFF" />
    </Style>
    <Style Selector="Border.stepnum > TextBlock">
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.size.selected">
      <Setter Property="Background" Value="{StaticResource AccentTintBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    </Style>
  </UserControl.Styles>
  <Grid x:Name="Root" ColumnDefinitions="250,*,Auto,360" RowDefinitions="Auto,*">

    <!-- Left: sizes (built-in, then removable custom sizes) and the portrait -->
    <Border Grid.RowSpan="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
      <ScrollViewer Padding="14,16">
        <StackPanel Spacing="6">
          <TextBlock Classes="section" Text="{l:Tr SourcePhoto}" Margin="2,0,0,4" />
          <Button Classes.primary="{Binding !HasSource}" Focusable="False" HorizontalAlignment="Stretch" MinHeight="40" Content="{l:Tr ChoosePhoto}" Command="{Binding ChoosePhotoCommand}" />
          <TextBlock Text="{Binding SourceName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="2,4,0,0" IsVisible="{Binding HasSource}" />
          <TextBlock Text="{l:Tr SourceSafe}" Foreground="{StaticResource OkBrush}" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding HasSource}" Margin="2,0,0,0" />
          <TextBlock Classes="section" Text="{l:Tr IdFormat}" Margin="2,18,0,4" />
          <ItemsControl ItemsSource="{Binding Sizes}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:IdSizeItem">
                <Button Classes="size" Classes.selected="{Binding IsSelected}" Focusable="False"
                        Command="{Binding $parent[UserControl].((vm:IdViewModel)DataContext).SelectSizeCommand}" CommandParameter="{Binding}">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Detail}" IsVisible="{Binding HasDetail}" FontSize="11.5" Classes="muted" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="section" Text="{l:Tr CustomSizes}" Margin="2,10,0,4" IsVisible="{Binding CustomSizes.Count}" />
          <ItemsControl ItemsSource="{Binding CustomSizes}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:IdSizeItem">
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                  <Button Classes="size" Classes.selected="{Binding IsSelected}" Focusable="False" Margin="0"
                          Command="{Binding $parent[UserControl].((vm:IdViewModel)DataContext).SelectSizeCommand}" CommandParameter="{Binding}">
                    <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="SemiBold" />
                  </Button>
                  <Button Grid.Column="1" Classes="list" Focusable="False" Margin="4,0,0,0" Padding="10,4" Content="✕" ToolTip.Tip="{l:Tr RemoveSize}"
                          Command="{Binding $parent[UserControl].((vm:IdViewModel)DataContext).RemoveCustomSizeCommand}" CommandParameter="{Binding}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Focusable="False" HorizontalAlignment="Stretch" Content="{l:Tr NewSize}" Command="{Binding ToggleNewSizeCommand}" IsVisible="{Binding !IsAddingSize}" />
          <Border IsVisible="{Binding IsAddingSize}" Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource Border2Brush}" BorderThickness="1" CornerRadius="8" Padding="10">
            <StackPanel Spacing="8">
              <TextBlock Text="{l:Tr NewSizeTitle}" FontWeight="SemiBold" />
              <Grid ColumnDefinitions="*,Auto,*,Auto">
                <NumericUpDown Value="{Binding NewSizeWidth}" Minimum="1" Maximum="15" Increment="0.1" FormatString="0.0#" ShowButtonSpinner="False" ToolTip.Tip="{l:Tr Width}" />
                <TextBlock Grid.Column="1" Text="×" Margin="6,0" VerticalAlignment="Center" />
                <NumericUpDown Grid.Column="2" Value="{Binding NewSizeHeight}" Minimum="1" Maximum="15" Increment="0.1" FormatString="0.0#" ShowButtonSpinner="False" ToolTip.Tip="{l:Tr Height}" />
                <TextBlock Grid.Column="3" Text="cm" Margin="6,0,0,0" VerticalAlignment="Center" />
              </Grid>
              <TextBlock Text="{Binding NewSizeError}" IsVisible="{Binding NewSizeError, Converter={x:Static ObjectConverters.IsNotNull}}" Foreground="{StaticResource WarnBrush}" FontSize="12" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="*,8,*">
                <Button Focusable="False" HorizontalAlignment="Stretch" Content="{l:Tr Cancel}" Command="{Binding ToggleNewSizeCommand}" />
                <Button Grid.Column="2" Classes="primary" Focusable="False" HorizontalAlignment="Stretch" Content="{l:Tr Add}" Command="{Binding AddCustomSizeCommand}" />
              </Grid>
            </StackPanel>
          </Border>
          <TextBlock Text="{l:Tr IdDisclaimer}" Foreground="{StaticResource WarnBrush}" FontSize="12" TextWrapping="Wrap" Margin="2,10,0,0" />
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- Steps: larger, numbered, no separator dash (prompt_04 §8) -->
    <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,9">
      <Border Classes="segbox" HorizontalAlignment="Center" Padding="3">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <ToggleButton Classes="segacc step" Focusable="False" IsChecked="{Binding IsFraming, Mode=OneWay}" Command="{Binding BackToFramingCommand}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Border Classes="stepnum"><TextBlock Text="1" /></Border>
              <TextBlock Text="{l:Tr Step1}" VerticalAlignment="Center" />
            </StackPanel>
          </ToggleButton>
          <ToggleButton Classes="segacc step" Focusable="False" IsChecked="{Binding IsSheetStep, Mode=OneWay}" Command="{Binding ContinueToSheetCommand}" IsEnabled="{Binding HasSource}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Border Classes="stepnum"><TextBlock Text="2" /></Border>
              <TextBlock Text="{l:Tr Step2}" VerticalAlignment="Center" />
            </StackPanel>
          </ToggleButton>
        </StackPanel>
      </Border>
    </Border>

    <!-- Center -->
    <Panel Grid.Column="1" Grid.Row="1" Background="{StaticResource CanvasBrush}">
      <c:IdCanvas x:Name="Canvas" IsVisible="{Binding ShowFraming}" Margin="16" Source="{Binding Preview}" Size="{Binding SelectedSize.Size}"
                  FrameWidth="{Binding PreviewFrameWidth}" FrameHeight="{x:Static vm:IdViewModel.PreviewFrameHeight}" />
      <Border IsVisible="{Binding ShowSheet}" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 6 18 0 #90000000">
        <Image Source="{Binding SheetPreview}" Stretch="Uniform" />
      </Border>
      <TextBlock IsVisible="{Binding ShowFraming}" Text="{l:Tr MoveHint}" Classes="muted" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10" />
      <!-- Choose the portrait with the built-in explorer (prompt_04 §6) -->
      <Grid IsVisible="{Binding IsPicking}" ColumnDefinitions="270,*" RowDefinitions="Auto,*" Background="{StaticResource BgBrush}">
        <Border Grid.ColumnSpan="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
          <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBlock Text="{l:Tr ChoosePortrait}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Grid.Column="1" Focusable="False" Content="{l:Tr Cancel}" Command="{Binding CancelPickCommand}" IsVisible="{Binding HasSource}" Margin="0,0,8,0" />
            <Button Grid.Column="2" Classes="primary" Focusable="False" Content="{l:Tr UsePhoto}" Command="{Binding Picker.PickCommand}" />
          </Grid>
        </Border>
        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
          <v:ExplorerView DataContext="{Binding Picker.Explorer}" />
        </Border>
        <v:PickerGrid Grid.Row="1" Grid.Column="1" Margin="10" DataContext="{Binding Picker}" />
      </Grid>
      <Border IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" Background="#4A1715" BorderBrush="#FF5A52" BorderThickness="1" CornerRadius="8" Padding="14,10"
              Margin="24" HorizontalAlignment="Center" VerticalAlignment="Top" MaxWidth="700">
        <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFD0CC" TextWrapping="Wrap" />
      </Border>
    </Panel>

    <!-- Resizable right panel (prompt_03 §3) -->
    <GridSplitter Grid.Column="2" Grid.RowSpan="2" Classes="panel" ResizeDirection="Columns" DragCompleted="OnSplitterDragCompleted" />

    <!-- Right: framing step -->
    <Border Grid.Column="3" Grid.RowSpan="2" Background="{StaticResource PanelBrush}">
      <Panel>
        <Grid RowDefinitions="*,Auto" IsVisible="{Binding !IsSheetStep}">
          <ScrollViewer Padding="18,16,18,8">
            <StackPanel Spacing="8" IsEnabled="{Binding HasSource}">
              <Button Classes="primary" Focusable="False" HorizontalAlignment="Stretch" MinHeight="44" FontSize="15" Content="{l:Tr AutoAlign}" Command="{Binding AutoAlignCommand}" IsEnabled="{Binding CanAutoAlign}" />
              <TextBlock Text="{l:Tr NoGuidesHint}" Classes="muted" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding !HasGuides}" />
              <TextBlock Text="{Binding StatusMessage}" Classes="muted" FontSize="12.5" TextWrapping="Wrap" IsVisible="{Binding StatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <ItemsControl ItemsSource="{Binding FaceChoices}" IsVisible="{Binding HasFaceChoices}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:FaceChoice">
                    <Button Focusable="False" HorizontalAlignment="Stretch" Margin="0,0,0,6" Content="{Binding Text}"
                            Command="{Binding $parent[UserControl].((vm:IdViewModel)DataContext).ChooseFaceCommand}" CommandParameter="{Binding}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Classes="link" Focusable="False" Content="{l:Tr KeepManual}" Command="{Binding KeepManualFramingCommand}" IsVisible="{Binding HasFaceChoices}" />
              <TextBlock Classes="section" Text="{l:Tr Framing}" Margin="0,8,0,0" />
              <Grid ColumnDefinitions="*,Auto"><TextBlock Classes="label" Text="{l:Tr Zoom}" /><TextBlock Grid.Column="1" Classes="value" Text="{Binding ZoomText}" /></Grid>
              <Slider Minimum="30" Maximum="400" Value="{Binding Zoom}" DoubleTapped="OnZoomDoubleTapped" ToolTip.Tip="{l:Tr DoubleClickReset}" />
              <Grid ColumnDefinitions="*,Auto"><TextBlock Classes="label" Text="{l:Tr IdRotation}" /><TextBlock Grid.Column="1" Classes="value" Text="{Binding RotationText}" /></Grid>
              <Slider Minimum="-20" Maximum="20" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding Rotation}" DoubleTapped="OnRotationDoubleTapped" ToolTip.Tip="{l:Tr DoubleClickReset}" />
              <v:ToneAdjustmentsView DataContext="{Binding Tone}" Margin="0,14,0,0" />
              <TextBlock Classes="section" Text="{l:Tr Background}" Margin="0,12,0,0" />
              <TextBlock Classes="label" Text="{l:Tr BackgroundBrightness}" />
              <Panel Margin="0,-6,0,-2">
                <Border Classes="track" Background="{StaticResource BackgroundTrack}" />
                <Slider Classes="tone" Minimum="0" Maximum="100" Value="{Binding BackgroundBrightness}" />
              </Panel>
            </StackPanel>
          </ScrollViewer>
          <StackPanel Grid.Row="1" Margin="18,8,18,16" Spacing="8">
            <TextBlock Text="{l:Tr SpaceBeforeAfter}" Classes="muted" FontSize="12" HorizontalAlignment="Center" />
            <Grid ColumnDefinitions="*,8,*">
              <Button Focusable="False" HorizontalAlignment="Stretch" Content="{l:Tr Undo2}" Command="{Binding UndoCommand}" />
              <Button Grid.Column="2" Focusable="False" HorizontalAlignment="Stretch" Content="{l:Tr Reset}" Command="{Binding ResetAllCommand}" />
            </Grid>
            <Button Classes="primary" Focusable="False" HorizontalAlignment="Stretch" MinHeight="52" Content="{l:Tr Continue}" Command="{Binding ContinueToSheetCommand}" IsEnabled="{Binding HasSource}" FontSize="15" />
          </StackPanel>
        </Grid>

        <!-- Right: sheet step -->
        <Grid RowDefinitions="*,Auto" IsVisible="{Binding IsSheetStep}">
          <ScrollViewer Padding="18,16,18,8">
            <StackPanel Spacing="8">
              <TextBlock Classes="section" Text="{l:Tr Page}" />
              <TextBlock Text="{Binding PageText}" Classes="muted" TextWrapping="Wrap" />
              <TextBlock Classes="section" Text="{l:Tr Layout}" Margin="0,10,0,0" />
              <TextBlock Text="{Binding PhotoInfo}" TextWrapping="Wrap" />
              <TextBlock Classes="section" Text="{l:Tr Copies}" Margin="0,10,0,0" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="square" Focusable="False" Content="−" Command="{Binding CopiesMinusCommand}" />
                <Border Background="{StaticResource Panel2Brush}" CornerRadius="7" Width="56" Height="34"><TextBlock Text="{Binding Copies}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <Button Classes="square" Focusable="False" Content="+" Command="{Binding CopiesPlusCommand}" />
                <TextBlock Text="{Binding CopiesText}" Classes="muted" VerticalAlignment="Center" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding FamiliarCounts}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:Int32">
                    <Button Classes="chip" Focusable="False" Content="{Binding}" Command="{Binding $parent[UserControl].((vm:IdViewModel)DataContext).SetCopiesCommand}" CommandParameter="{Binding}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Grid ColumnDefinitions="*,120" RowDefinitions="Auto,Auto" Margin="0,6,0,0">
                <TextBlock Text="{l:Tr Spacing}" VerticalAlignment="Center" />
                <NumericUpDown Grid.Column="1" Value="{Binding SpacingMm}" Minimum="0" Maximum="10" Increment="0.5" FormatString="0.#" />
                <TextBlock Grid.Row="1" Text="{l:Tr Margins}" VerticalAlignment="Center" Margin="0,8,0,0" />
                <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding MarginMm}" Minimum="0" Maximum="15" Increment="0.5" FormatString="0.#" Margin="0,8,0,0" />
              </Grid>
              <CheckBox IsChecked="{Binding IncludeStrip}" IsVisible="{Binding HasStripOption}" Content="{l:Tr IncludeStrip}" Margin="0,4,0,0" />
              <TextBlock Text="{l:Tr EdgeToEdgeNote}" IsVisible="{Binding IsEdgeToEdge}" Foreground="{StaticResource WarnBrush}" FontSize="12" TextWrapping="Wrap" />
              <TextBlock Classes="section" Text="{l:Tr Output}" Margin="0,10,0,0" />
              <TextBlock Text="{l:Tr OutputFolder}" Classes="muted" FontSize="12" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding OutputFolderText}" ToolTip.Tip="{Binding OutputFolder}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontWeight="SemiBold" />
                <Button Grid.Column="1" Focusable="False" Content="{l:Tr Change}" Command="{Binding ChangeOutputFolderCommand}" Margin="8,0,0,0" />
              </Grid>
              <TextBlock Text="{l:Tr FileName}" Classes="muted" FontSize="12" Margin="0,6,0,0" />
              <TextBlock Text="{Binding FileNamePreview}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource OkBrush}" TextWrapping="Wrap" />
              <Button Classes="link" Focusable="False" Content="{l:Tr Calibration}" Command="{Binding SaveCalibrationCommand}" Margin="0,6,0,0" />
            </StackPanel>
          </ScrollViewer>
          <Grid Grid.Row="1" ColumnDefinitions="Auto,8,*" Margin="18,8,18,16">
            <Button Focusable="False" MinHeight="52" Content="{l:Tr Back}" Command="{Binding BackToFramingCommand}" />
            <Button Grid.Column="2" Classes="primary" Focusable="False" HorizontalAlignment="Stretch" MinHeight="52" FontSize="15" Content="{l:Tr SaveSheet}" Command="{Binding SaveSheetCommand}" IsEnabled="{Binding !IsBusy}" />
          </Grid>
        </Grid>
      </Panel>
    </Border>
  </Grid>
</UserControl>

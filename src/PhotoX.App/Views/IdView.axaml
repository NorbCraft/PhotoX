<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PhotoX.App.ViewModels"
             xmlns:l="using:PhotoX.App.Localization"
             x:Class="PhotoX.App.Views.IdView"
             x:DataType="vm:IdViewModel">
  <Border Background="{StaticResource CanvasBrush}">
    <TextBlock Text="{l:Tr IdComingSoon}" Classes="muted" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
  </Border>
</UserControl>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PhotoX.App.ViewModels"
        xmlns:l="using:PhotoX.App.Localization"
        xmlns:v="using:PhotoX.App.Views"
        xmlns:s="using:PhotoX.App.Services"
        xmlns:c="using:PhotoX.App.Controls"
        x:Class="PhotoX.App.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Icon="/Assets/photox.ico"
        Title="{Binding WindowTitle}"
        Width="1440" Height="900" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="56,*">
    <!-- Top bar (FR-008, FR-009): the three workspaces on the left; Printing, language, settings and the PhotoX name on the right (prompt_05 §1, prompt_06 §1, prompt_07 §3.8) -->
    <Border Grid.Row="0" Background="{DynamicResource BarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="12,0,16,0">
        <!-- Show or hide the folder tree of the workspace shown; each workspace remembers its own choice (prompt_08 §4) -->
        <ToggleButton x:Name="TreeToggle" Classes="icon tree" Focusable="False" Margin="0,0,10,0" VerticalAlignment="Center" ToolTip.Tip="{l:Tr ToggleTree}"
                      IsChecked="{Binding IsTreeVisible, Mode=OneWay}" Command="{Binding ToggleTreeCommand}">
          <Path Data="{x:Static s:Icons.Sidebar}" />
        </ToggleButton>
        <Border Grid.Column="1" Background="{DynamicResource Panel2Brush}" CornerRadius="10" Padding="4" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <c:ChoiceButton Classes="seg ws" Focusable="False" IsChecked="{Binding IsPhotosWorkspace, Mode=OneWay}" Command="{Binding ShowPhotosCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8"><Path Data="{x:Static s:Icons.Photos}" /><TextBlock Text="{l:Tr TabPhotos}" VerticalAlignment="Center" /></StackPanel>
            </c:ChoiceButton>
            <c:ChoiceButton Classes="seg ws" Focusable="False" IsChecked="{Binding IsIdWorkspace, Mode=OneWay}" Command="{Binding ShowIdCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8"><Path Data="{x:Static s:Icons.IdPhoto}" /><TextBlock Text="{l:Tr TabId}" VerticalAlignment="Center" /></StackPanel>
            </c:ChoiceButton>
            <c:ChoiceButton Classes="seg ws" Focusable="False" IsChecked="{Binding IsCollageWorkspace, Mode=OneWay}" Command="{Binding ShowCollagesCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8"><Path Data="{x:Static s:Icons.Collage}" /><TextBlock Text="{l:Tr TabCollages}" VerticalAlignment="Center" /></StackPanel>
            </c:ChoiceButton>
          </StackPanel>
        </Border>
        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Margin="12,0">
          <TextBlock Text="{Binding ContextText}" Classes="muted" FontSize="14" TextTrimming="CharacterEllipsis" MaxWidth="460" VerticalAlignment="Center" />
          <Border IsVisible="{Binding ShowUnsaved}" Background="{DynamicResource WarnBgBrush}" BorderBrush="{DynamicResource WarnBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10,3">
            <TextBlock Text="{l:Tr Unsaved}" Foreground="{DynamicResource WarnTextBrush}" FontSize="12.5" FontWeight="SemiBold" />
          </Border>
        </StackPanel>
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <!-- Printing, apart from the three creation workspaces (prompt_07 §3.8) -->
          <Border Background="{DynamicResource Panel2Brush}" CornerRadius="10" Padding="4" VerticalAlignment="Center">
              <c:ChoiceButton Classes="seg ws" Focusable="False" IsChecked="{Binding IsPrintWorkspace, Mode=OneWay}" Command="{Binding ShowPrintingCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Path Data="{x:Static s:Icons.Printer}" />
                  <TextBlock Text="{l:Tr TabPrinting}" VerticalAlignment="Center" />
                  <!-- Jobs in progress; amber when Windows reports a problem -->
                  <Border IsVisible="{Binding Print.Queue.HasActive}" Classes="wsbadge" Classes.attention="{Binding Print.Queue.NeedsAttention}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PrintBadge}" />
                  </Border>
                </StackPanel>
              </c:ChoiceButton>
          </Border>
          <Border Background="{DynamicResource Panel2Brush}" BorderBrush="{DynamicResource Border2Brush}" BorderThickness="1" CornerRadius="15" Padding="2" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <c:ChoiceButton Classes="seg lang" Focusable="False" CornerRadius="13" Padding="12,3" MinHeight="26" FontWeight="Bold" Content="EN"
                            IsChecked="{Binding IsEnglish, Mode=OneWay}" Command="{Binding SetLanguageCommand}" CommandParameter="en" />
              <c:ChoiceButton Classes="seg lang" Focusable="False" CornerRadius="13" Padding="12,3" MinHeight="26" FontWeight="Bold" Content="RO"
                            IsChecked="{Binding IsRomanian, Mode=OneWay}" Command="{Binding SetLanguageCommand}" CommandParameter="ro" />
            </StackPanel>
          </Border>
          <Button Classes="list" Focusable="False" Padding="8,4" Command="{Binding OpenSettingsCommand}" ToolTip.Tip="{l:Tr Settings}">
            <Path Data="{x:Static s:Icons.Settings}" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.7" StrokeJoin="Round" Width="22" Height="22" Stretch="Uniform" />
          </Button>
          <!-- PhotoX: the icon and the name, the X in the primary blue of the icon -->
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="6,0,0,0">
            <Image Source="/Assets/photox-icon-64.png" Width="36" Height="36" VerticalAlignment="Center" RenderOptions.BitmapInterpolationMode="HighQuality" />
            <TextBlock FontSize="21" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,0,2">
              <Run Text="Photo" Foreground="{DynamicResource TextBrush}" /><Run Text="X" Foreground="{DynamicResource AccentBrush}" />
            </TextBlock>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <!-- The pages stay alive while hidden, so switching never rebuilds the gallery or the editor (prompt_03 §9). -->
    <Panel Grid.Row="1">
      <Panel IsVisible="{Binding IsBrowsing}"><v:BrowseView DataContext="{Binding Browse}" /></Panel>
      <Panel IsVisible="{Binding IsEditing}"><v:EditorView DataContext="{Binding Editor}" /></Panel>
      <Panel IsVisible="{Binding IsIdWorkspace}"><v:IdView DataContext="{Binding Id}" /></Panel>
      <Panel IsVisible="{Binding IsCollageWorkspace}"><v:CollageView DataContext="{Binding Collage}" /></Panel>
      <Panel IsVisible="{Binding IsPrintWorkspace}"><v:PrintView DataContext="{Binding Print}" /></Panel>
    </Panel>

    <!-- Settings (FR-040) -->
    <Panel Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding Settings, Converter={x:Static ObjectConverters.IsNotNull}}" Background="{DynamicResource OverlayBrush}">
      <Border DataContext="{Binding Settings}" x:DataType="vm:SettingsViewModel" Width="560" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20"
              Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource Border2Brush}" BorderThickness="1" CornerRadius="12" Padding="0,0,0,20">
        <DockPanel>
        <Button DockPanel.Dock="Bottom" Classes="primary" HorizontalAlignment="Right" MinWidth="120" Margin="24,12,24,0" Content="{l:Tr Close}" Command="{Binding CloseCommand}" />
        <!-- Third-party licences (About): each component with its version, licence and project page -->
        <DockPanel IsVisible="{Binding ShowLicences}" Margin="24,24,24,0">
          <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="0,0,0,8">
            <Button Classes="icon" Focusable="False" Command="{Binding ToggleLicencesCommand}" ToolTip.Tip="{l:Tr Back}" Margin="0,0,10,0">
              <Path Data="{x:Static s:Icons.ChevronLeft}" />
            </Button>
            <TextBlock Grid.Column="1" Text="{l:Tr ThirdPartyLicences}" FontSize="19" FontWeight="Bold" VerticalAlignment="Center" />
          </Grid>
          <TextBlock DockPanel.Dock="Top" Text="{l:Tr LicencesIntro}" Classes="muted" TextWrapping="Wrap" Margin="0,0,0,10" />
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Components}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="s:ThirdPartyComponent">
                  <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="12.5" TextWrapping="Wrap" />
                      <Button Classes="link" Focusable="False" HorizontalAlignment="Left" Padding="0,1" FontSize="12.5" IsVisible="{Binding HasSource}"
                              Content="{Binding Source}" ToolTip.Tip="{Binding Source}"
                              Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).OpenSourceCommand}" CommandParameter="{Binding}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="24,24,24,0" IsVisible="{Binding !ShowLicences}">
        <StackPanel Spacing="16">
          <TextBlock Text="{l:Tr SettingsTitle}" FontSize="19" FontWeight="Bold" />
          <!-- Light or dark mode (prompt_06 §3) -->
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{l:Tr Appearance}" VerticalAlignment="Center" FontWeight="SemiBold" />
            <Border Grid.Column="1" Classes="segbox">
              <StackPanel Orientation="Horizontal">
                <c:ChoiceButton Classes="segacc" Focusable="False" MinWidth="64" Content="{l:Tr ThemeLight}" IsChecked="{Binding IsLight, Mode=OneWay}" Command="{Binding SetThemeCommand}" CommandParameter="light" />
                <c:ChoiceButton Classes="segacc" Focusable="False" MinWidth="64" Content="{l:Tr ThemeDark}" IsChecked="{Binding !IsLight, Mode=OneWay}" Command="{Binding SetThemeCommand}" CommandParameter="dark" />
              </StackPanel>
            </Border>
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{l:Tr JpegQuality}" VerticalAlignment="Center" FontWeight="SemiBold" />
            <NumericUpDown Grid.Column="1" Width="130" Minimum="80" Maximum="100" Increment="1" FormatString="0" Value="{Binding JpegQuality}" ToolTip.Tip="{l:Tr JpegQualityTip}" />
          </Grid>
          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{l:Tr IdScale}" VerticalAlignment="Center" FontWeight="SemiBold" />
              <NumericUpDown Grid.Column="1" Width="130" Minimum="90" Maximum="110" Increment="0.1" FormatString="0.0" Value="{Binding IdScalePercent}" />
            </Grid>
            <TextBlock Text="{l:Tr IdScaleHint}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Spacing="6">
            <TextBlock Text="{l:Tr DataFilesTitle}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding DataFilesText}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Spacing="6">
            <TextBlock Text="{l:Tr ThumbnailCache}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding CacheText}" Classes="muted" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Button Command="{Binding ClearCacheCommand}" Padding="10,6,14,6">
                <c:IconLabel Icon="{x:Static s:Icons.Delete}" Text="{l:Tr ClearCache}" />
              </Button>
              <TextBlock Text="{Binding CacheMessage}" Classes="ok" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
          <!-- Check for updates (prompt_08 §6): the latest stable release on GitHub -->
          <StackPanel Spacing="8">
            <TextBlock Text="{l:Tr Updates}" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding InstalledVersionText}" Classes="muted" VerticalAlignment="Center" />
              <Button Grid.Column="1" Command="{Binding CheckUpdatesCommand}" Padding="10,6,14,6">
                <c:IconLabel Icon="{x:Static s:Icons.Reset}" Text="{l:Tr CheckUpdates}" />
              </Button>
            </Grid>
            <TextBlock Text="{Binding UpdateStatus}" IsVisible="{Binding HasUpdateStatus}" TextWrapping="Wrap" Classes.warn="{Binding UpdateStatusIsWarning}" Classes.ok="{Binding HasUpdate}" />
            <Button Classes="primary" HorizontalAlignment="Left" Padding="12,8,16,8" IsVisible="{Binding CanInstall}" Command="{Binding InstallUpdateCommand}">
              <c:IconLabel Icon="{x:Static s:Icons.Download}" Text="{l:Tr UpdateNow}" />
            </Button>
            <Button HorizontalAlignment="Left" Padding="12,8,16,8" IsVisible="{Binding CanOpenPage}" Command="{Binding OpenReleasePageCommand}">
              <c:IconLabel Icon="{x:Static s:Icons.Download}" Text="{l:Tr OpenReleasePage}" />
            </Button>
            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsDownloading}">
              <StackPanel Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="{Binding DownloadText}" Classes="muted" />
                <ProgressBar Minimum="0" Maximum="1" Value="{Binding DownloadProgress}" />
              </StackPanel>
              <Button Grid.Column="1" Margin="12,0,0,0" Content="{l:Tr Cancel}" Command="{Binding CancelDownloadCommand}" />
            </Grid>
          </StackPanel>
          <!-- About: logo, name, version of this build, what PhotoX is, the third-party licences -->
          <StackPanel Spacing="10">
            <TextBlock Text="{l:Tr About}" FontWeight="SemiBold" />
            <Border Background="{DynamicResource Panel2Brush}" CornerRadius="10" Padding="16,14">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="Auto,*">
                  <Image Source="/Assets/photox-icon-256.png" Width="52" Height="52" VerticalAlignment="Center" Margin="0,0,14,0" RenderOptions.BitmapInterpolationMode="HighQuality" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                    <TextBlock FontSize="21" FontWeight="Bold">
                      <Run Text="Photo" Foreground="{DynamicResource TextBrush}" /><Run Text="X" Foreground="{DynamicResource AccentBrush}" />
                    </TextBlock>
                    <TextBlock Text="{Binding AboutVersionText}" Classes="muted" />
                  </StackPanel>
                </Grid>
                <TextBlock Text="{l:Tr AboutTagline}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{l:Tr AboutDescription}" Classes="muted" TextWrapping="Wrap" />
                <Button Classes="link" Focusable="False" HorizontalAlignment="Left" Padding="0,2" Content="{l:Tr ThirdPartyLicences}" Command="{Binding ToggleLicencesCommand}" />
              </StackPanel>
            </Border>
            <TextBlock Text="{Binding InstallText}" Classes="faint" FontSize="12" TextWrapping="Wrap" />
            <TextBlock Text="{Binding LogsText}" Classes="faint" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>
        </ScrollViewer>
        </DockPanel>
      </Border>
    </Panel>
    <!-- In-window dialogs (warnings, unsaved changes, messages), above Settings so the update can ask -->
    <Panel Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding Dialog, Converter={x:Static ObjectConverters.IsNotNull}}" Background="{DynamicResource OverlayBrush}">
      <Border DataContext="{Binding Dialog}" x:DataType="vm:DialogViewModel" Width="580" HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource Border2Brush}" BorderThickness="1" CornerRadius="12" Padding="24">
        <StackPanel Spacing="14">
          <TextBlock Text="{Binding Title}" FontSize="19" FontWeight="Bold" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Message}" Classes="muted" FontSize="14" TextWrapping="Wrap" />
          <ItemsControl IsVisible="{Binding HasChoices}" ItemsSource="{Binding Choices}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DialogChoice">
                <Button Classes="choice" Classes.selected="{Binding IsSelected}" Margin="0,0,0,10" Padding="16,12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Command="{Binding $parent[Border].((vm:DialogViewModel)DataContext).ChooseCommand}" CommandParameter="{Binding}">
                  <Grid ColumnDefinitions="Auto,*">
                    <Panel Width="20" Height="20" VerticalAlignment="Top" Margin="0,2,14,0">
                      <Ellipse Stroke="{DynamicResource Text2Brush}" StrokeThickness="2" />
                      <Ellipse Width="9" Height="9" Fill="{DynamicResource AccentBrush}" IsVisible="{Binding IsSelected}" />
                    </Panel>
                    <StackPanel Grid.Column="1" Spacing="4">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" />
                      <TextBlock Text="{Binding Description}" Classes="muted" FontSize="12.5" TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock IsVisible="{Binding HasNote}" Text="{Binding Note}" Foreground="{DynamicResource Text3Brush}" FontSize="12" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding Buttons}" HorizontalAlignment="Right">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="10" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DialogButton">
                <Button Classes.primary="{Binding IsPrimary}" MinWidth="120" MinHeight="40" Content="{Binding Text}"
                        Command="{Binding $parent[Border].((vm:DialogViewModel)DataContext).PressCommand}" CommandParameter="{Binding Id}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </Panel>

  </Grid>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PhotoX.App.ViewModels"
        xmlns:l="using:PhotoX.App.Localization"
        x:Class="PhotoX.App.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Icon="/Assets/photox.ico"
        Title="PhotoX"
        Width="1440" Height="900" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="56,*">
    <!-- Top bar (FR-008, FR-009) -->
    <Border Grid.Row="0" Background="{StaticResource BarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="16,0">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Image Source="/Assets/photox-icon-256.png" Width="26" Height="26" />
          <TextBlock Text="PhotoX" FontSize="19" FontWeight="Bold" VerticalAlignment="Center" />
        </StackPanel>
        <Border Grid.Column="1" Margin="28,0,0,0" Background="{StaticResource Panel2Brush}" CornerRadius="10" Padding="4" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <ToggleButton Classes="seg" Focusable="False" MinWidth="140" IsChecked="{Binding IsPhotosWorkspace, Mode=OneWay}" Command="{Binding ShowPhotosCommand}" Content="{l:Tr TabPhotos}" />
            <ToggleButton Classes="seg" Focusable="False" MinWidth="140" IsChecked="{Binding IsIdWorkspace, Mode=OneWay}" Command="{Binding ShowIdCommand}" Content="{l:Tr TabId}" />
          </StackPanel>
        </Border>
        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
          <TextBlock Text="{Binding ContextText}" Classes="muted" FontSize="14" TextTrimming="CharacterEllipsis" MaxWidth="560" VerticalAlignment="Center" />
          <Border IsVisible="{Binding ShowUnsaved}" Background="#3A2C10" BorderBrush="#7A5714" BorderThickness="1" CornerRadius="12" Padding="10,3">
            <TextBlock Text="{l:Tr Unsaved}" Foreground="#F8D48A" FontSize="12.5" FontWeight="SemiBold" />
          </Border>
        </StackPanel>
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <Border Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource Border2Brush}" BorderThickness="1" CornerRadius="15" Padding="2" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <ToggleButton Classes="seg lang" Focusable="False" CornerRadius="13" Padding="12,3" MinHeight="26" FontWeight="Bold" Content="EN"
                          IsChecked="{Binding IsEnglish, Mode=OneWay}" Command="{Binding SetLanguageCommand}" CommandParameter="en" />
            <ToggleButton Classes="seg lang" Focusable="False" CornerRadius="13" Padding="12,3" MinHeight="26" FontWeight="Bold" Content="RO"
                          IsChecked="{Binding IsRomanian, Mode=OneWay}" Command="{Binding SetLanguageCommand}" CommandParameter="ro" />
          </StackPanel>
        </Border>
        <Button Classes="list" Focusable="False" Padding="8,4" Command="{Binding OpenSettingsCommand}" ToolTip.Tip="{l:Tr Settings}">
          <Path Data="M12 15.2a3.2 3.2 0 1 0 0-6.4 3.2 3.2 0 0 0 0 6.4z M19.4 13.5l1.6 1.2-1.9 3.3-1.9-.7a7.6 7.6 0 0 1-2.3 1.3l-.3 2h-3.8l-.3-2a7.6 7.6 0 0 1-2.3-1.3l-1.9.7L3 14.7l1.6-1.2a7.7 7.7 0 0 1 0-3L3 9.3 4.9 6l1.9.7A7.6 7.6 0 0 1 9.1 5.4l.3-2h3.8l.3 2a7.6 7.6 0 0 1 2.3 1.3L17.7 6l1.9 3.3-1.6 1.2a7.7 7.7 0 0 1 0 3z"
                Stroke="{StaticResource Text2Brush}" StrokeThickness="1.6" Width="20" Height="20" Stretch="Uniform" />
        </Button>
        </StackPanel>
      </Grid>
    </Border>

    <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" />

    <!-- In-window dialogs (Finish Order, unsaved changes, messages) -->
    <Panel Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding Dialog, Converter={x:Static ObjectConverters.IsNotNull}}" Background="#99000000">
      <Border DataContext="{Binding Dialog}" x:DataType="vm:DialogViewModel" Width="580" HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource Border2Brush}" BorderThickness="1" CornerRadius="12" Padding="24">
        <StackPanel Spacing="14">
          <TextBlock Text="{Binding Title}" FontSize="19" FontWeight="Bold" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Message}" Classes="muted" FontSize="14" TextWrapping="Wrap" />
          <ItemsControl IsVisible="{Binding HasChoices}" ItemsSource="{Binding Choices}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DialogChoice">
                <Button Classes="choice" Classes.selected="{Binding IsSelected}" Margin="0,0,0,10" Padding="16,12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Command="{Binding $parent[Border].((vm:DialogViewModel)DataContext).ChooseCommand}" CommandParameter="{Binding}">
                  <Grid ColumnDefinitions="Auto,*">
                    <Panel Width="20" Height="20" VerticalAlignment="Top" Margin="0,2,14,0">
                      <Ellipse Stroke="{StaticResource Text2Brush}" StrokeThickness="2" />
                      <Ellipse Width="9" Height="9" Fill="{StaticResource AccentBrush}" IsVisible="{Binding IsSelected}" />
                    </Panel>
                    <StackPanel Grid.Column="1" Spacing="4">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" />
                      <TextBlock Text="{Binding Description}" Classes="muted" FontSize="12.5" TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock IsVisible="{Binding HasNote}" Text="{Binding Note}" Foreground="{StaticResource Text3Brush}" FontSize="12" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding Buttons}" HorizontalAlignment="Right">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="10" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DialogButton">
                <Button Classes.primary="{Binding IsPrimary}" MinWidth="120" MinHeight="40" Content="{Binding Text}"
                        Command="{Binding $parent[Border].((vm:DialogViewModel)DataContext).PressCommand}" CommandParameter="{Binding Id}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </Panel>

    <!-- Settings (FR-040) -->
    <Panel Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding Settings, Converter={x:Static ObjectConverters.IsNotNull}}" Background="#99000000">
      <Border DataContext="{Binding Settings}" x:DataType="vm:SettingsViewModel" Width="560" HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource Border2Brush}" BorderThickness="1" CornerRadius="12" Padding="24">
        <StackPanel Spacing="16">
          <TextBlock Text="{l:Tr SettingsTitle}" FontSize="19" FontWeight="Bold" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{l:Tr JpegQuality}" VerticalAlignment="Center" FontWeight="SemiBold" />
            <NumericUpDown Grid.Column="1" Width="130" Minimum="80" Maximum="100" Increment="1" FormatString="0" Value="{Binding JpegQuality}" />
          </Grid>
          <StackPanel Spacing="6">
            <TextBlock Text="{l:Tr ThumbnailCache}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding CacheText}" Classes="muted" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Button Content="{l:Tr ClearCache}" Command="{Binding ClearCacheCommand}" />
              <TextBlock Text="{Binding CacheMessage}" Foreground="{StaticResource OkBrush}" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
          <StackPanel Spacing="6">
            <TextBlock Text="{l:Tr About}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding AboutText}" Classes="muted" TextWrapping="Wrap" />
            <TextBlock Text="{Binding LogsText}" Foreground="{StaticResource Text3Brush}" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>
          <Button Classes="primary" HorizontalAlignment="Right" MinWidth="120" Content="{l:Tr Close}" Command="{Binding CloseCommand}" />
        </StackPanel>
      </Border>
    </Panel>
  </Grid>
</Window>

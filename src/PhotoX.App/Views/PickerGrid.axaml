<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PhotoX.App.ViewModels"
             xmlns:l="using:PhotoX.App.Localization"
             xmlns:s="using:PhotoX.App.Services"
             x:Class="PhotoX.App.Views.PickerGrid"
             x:DataType="vm:PhotoPickerViewModel">
  <!-- Thumbnails of the folder open in the picker's explorer (prompt_04 §6). Double-click or Enter picks a photo. -->
  <Panel>
    <TextBlock IsVisible="{Binding !HasFolder}" Text="{l:Tr PickFolder}" Classes="muted" TextWrapping="Wrap" TextAlignment="Center" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
    <TextBlock IsVisible="{Binding IsEmpty}" Text="{l:Tr NoPhotos}" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" />
    <TextBlock IsVisible="{Binding IsScanning}" Text="{l:Tr Loading}" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" />
    <ListBox x:Name="Grid" Background="Transparent" ItemsSource="{Binding Photos}" SelectedItem="{Binding SelectedPhoto}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.Styles>
        <Style Selector="ListBoxItem">
          <Setter Property="Padding" Value="0" />
          <Setter Property="Margin" Value="4" />
          <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter, ListBoxItem:pointerover /template/ ContentPresenter">
          <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.card">
          <Setter Property="BorderThickness" Value="2" />
          <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
          <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        </Style>
        <Style Selector="ListBoxItem:selected Border.card">
          <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
          <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
          <Setter Property="BorderThickness" Value="3" />
        </Style>
        <Style Selector="ListBoxItem:pointerover Border.card">
          <Setter Property="BorderBrush" Value="{DynamicResource Border2Brush}" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:PickerPhoto">
          <Border Classes="card" Width="{Binding $parent[UserControl].((vm:PhotoPickerViewModel)DataContext).ThumbWidth}" Height="{Binding $parent[UserControl].((vm:PhotoPickerViewModel)DataContext).ThumbHeight}"
                  CornerRadius="8" DoubleTapped="OnPhotoDoubleTapped" ToolTip.Tip="{Binding Name}">
            <Grid RowDefinitions="*,Auto" Margin="6">
              <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
              <TextBlock Text="…" IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNull}}" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" />
              <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="12" Margin="2,5,2,0" TextTrimming="CharacterEllipsis" Classes.faint="{Binding !IsOpenable}" />
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Panel>
</UserControl>

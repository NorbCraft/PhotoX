<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PhotoX.App.ViewModels"
             xmlns:l="using:PhotoX.App.Localization"
             xmlns:f="using:PhotoX.Core.Formats"
             xmlns:s="using:PhotoX.App.Services"
             x:Class="PhotoX.App.Views.PrintView"
             x:DataType="vm:PrintViewModel">
  <UserControl.Styles>
    <Style Selector="Border.job">
      <Setter Property="Background" Value="{DynamicResource Panel2Brush}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style Selector="Border.tile">
      <Setter Property="Background" Value="{DynamicResource Panel2Brush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Margin" Value="0,0,6,6" />
    </Style>
    <Style Selector="TextBlock.muted.cancelled">
      <Setter Property="Foreground" Value="{DynamicResource Text3Brush}" />
    </Style>
  </UserControl.Styles>
  <!-- Printing workspace (prompt_06 §7): queue, history and statistics | what will print | printer and options -->
  <Grid x:Name="Root" ColumnDefinitions="340,Auto,*,Auto,340" RowDefinitions="Auto,*">

    <!-- Toolbar: back to the workspace that sent the print, and what is about to print -->
    <Border Grid.ColumnSpan="5" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,7" MinHeight="49">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Button Classes="icon large" Focusable="False" Command="{Binding BackCommand}" IsVisible="{Binding HasOrigin}" ToolTip.Tip="{Binding BackText}">
          <Path Data="{x:Static s:Icons.FolderBack}" />
        </Button>
        <Border Classes="sep" IsVisible="{Binding HasOrigin}" />
        <TextBlock Text="{Binding SummaryText}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- Left: statistics, the queue of this session and the history -->
    <Border Grid.Row="1" Background="{DynamicResource PanelBrush}">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="16,14,10,10">
        <!-- Statistics fold away when Print opens this workspace: customers may see this screen (prompt_07 §3.1) -->
        <StackPanel Spacing="6">
          <Button Classes="list" Focusable="False" Padding="0,2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding ToggleStatisticsCommand}" ToolTip.Tip="{l:Tr StatToggleTip}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Classes="section" Text="{l:Tr Statistics}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding !StatisticsOpen, Converter={x:Static s:IconConverter.Chevron}}" Classes="faint" FontSize="11" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <ItemsControl ItemsSource="{Binding History.Tiles}" ToolTip.Tip="{l:Tr StatTip}" IsVisible="{Binding StatisticsOpen}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PrintStatTile">
                <Border Classes="tile">
                  <StackPanel Spacing="1">
                    <TextBlock Text="{Binding Title}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Prints}" FontSize="22" FontWeight="Bold" />
                    <TextBlock Text="{Binding Split}" Classes="faint" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <TextBlock Grid.Row="1" Classes="section" Text="{l:Tr PrintQueueTitle}" Margin="0,12,0,6" />
        <Panel Grid.Row="2">
          <TextBlock IsVisible="{Binding !Queue.HasActive}" Text="{l:Tr QueueEmpty}" Classes="faint" FontSize="12.5" TextWrapping="Wrap" />
          <ScrollViewer MaxHeight="280" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Queue.Active}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PrintJobItem">
                  <Border Classes="job">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Row="1" Text="{Binding Details}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Row="2" Text="{Binding StatusText}" FontSize="12.5" TextWrapping="Wrap" Classes="muted" Classes.warn="{Binding IsWarn}" Classes.error="{Binding IsError}" />
                      <ProgressBar Grid.Row="3" IsIndeterminate="True" IsVisible="{Binding IsBusy}" Margin="0,5,0,1" Foreground="{DynamicResource AccentBrush}" />
                      <Button Grid.Column="1" Grid.RowSpan="4" Focusable="False" Content="{l:Tr Cancel}" IsVisible="{Binding CanCancel}" VerticalAlignment="Center" Margin="8,0,0,0"
                              Command="{Binding $parent[ItemsControl].((vm:PrintQueueViewModel)DataContext).CancelCommand}" CommandParameter="{Binding}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Panel>

        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,14,0,6">
          <TextBlock Classes="section" Text="{l:Tr HistoryTitle}" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
            <Button Classes="chip compact" Focusable="False" Content="{l:Tr PeriodToday}" Command="{Binding History.SetPeriodCommand}" CommandParameter="{x:Static vm:HistoryPeriod.Today}"
                    Classes.selected="{Binding History.Period, Converter={x:Static s:EqualsConverter.Instance}, ConverterParameter=Today}" />
            <Button Classes="chip compact" Focusable="False" Content="{l:Tr PeriodWeek}" Command="{Binding History.SetPeriodCommand}" CommandParameter="{x:Static vm:HistoryPeriod.Week}"
                    Classes.selected="{Binding History.Period, Converter={x:Static s:EqualsConverter.Instance}, ConverterParameter=Week}" />
            <Button Classes="chip compact" Focusable="False" Content="{l:Tr PeriodMonth}" Command="{Binding History.SetPeriodCommand}" CommandParameter="{x:Static vm:HistoryPeriod.Month}"
                    Classes.selected="{Binding History.Period, Converter={x:Static s:EqualsConverter.Instance}, ConverterParameter=Month}" />
          </StackPanel>
        </Grid>
        <Panel Grid.Row="4">
          <TextBlock IsVisible="{Binding !History.HasEntries}" Text="{l:Tr HistoryEmpty}" Classes="faint" FontSize="12.5" TextWrapping="Wrap" />
          <ListBox ItemsSource="{Binding History.Entries}" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,0,6" />
              </Style>
              <Style Selector="ListBoxItem:selected /template/ ContentPresenter, ListBoxItem:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="Transparent" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:PrintHistoryItem">
                <Border Classes="job" Margin="0">
                  <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
                    <TextBlock Text="{Binding Time}" Classes="muted" FontSize="12" Margin="0,1,10,0" />
                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding Details}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Grid.Row="2" Text="{Binding OutcomeText}" FontSize="12.5" TextWrapping="Wrap"
                               Classes="muted" Classes.ok="{Binding IsOk}" Classes.error="{Binding IsError}" Classes.faint="{Binding IsMuted}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Panel>
      </Grid>
    </Border>
    <GridSplitter Grid.Row="1" Grid.Column="1" Classes="panel" ResizeDirection="Columns" DragCompleted="OnLeftSplitterDragCompleted" />

    <!-- Centre: the pages as they will print -->
    <Panel Grid.Row="1" Grid.Column="2" Background="{DynamicResource CanvasBrush}">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasItems}">
        <StackPanel Spacing="8" Margin="16">
          <ItemsControl ItemsSource="{Binding Previews}" HorizontalAlignment="Center">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PrintPreviewItem">
                <StackPanel Margin="10" Spacing="5" Width="{Binding $parent[UserControl].((vm:PrintViewModel)DataContext).PreviewWidth}">
                  <Border Background="White" BoxShadow="0 3 12 0 #70000000"
                          Width="{Binding $parent[UserControl].((vm:PrintViewModel)DataContext).PreviewWidth}"
                          Height="{Binding $parent[UserControl].((vm:PrintViewModel)DataContext).PreviewHeight}">
                    <Panel>
                      <Image Source="{Binding Page}" Stretch="Fill" />
                      <TextBlock Text="…" Foreground="#888888" IsVisible="{Binding Page, Converter={x:Static ObjectConverters.IsNull}}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Panel>
                  </Border>
                  <TextBlock Text="{Binding Name}" FontSize="12" Classes="muted" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding MorePreviewsText}" IsVisible="{Binding HasMorePreviews}" Classes="muted" HorizontalAlignment="Center" />
        </StackPanel>
      </ScrollViewer>
      <StackPanel IsVisible="{Binding !HasItems}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="460">
        <Path Data="{x:Static s:Icons.Printer}" Stroke="{DynamicResource Text3Brush}" StrokeThickness="1.2" StrokeJoin="Round" StrokeLineCap="Round" Width="24" Height="24" Stretch="None"
              HorizontalAlignment="Center" RenderTransform="scale(2.4)" Margin="0,0,0,22" />
        <TextBlock Text="{Binding StatusMessage}" IsVisible="{Binding StatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}" FontSize="16" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Classes="ok" />
        <TextBlock Text="{l:Tr PrintEmptyHint}" Classes="muted" FontSize="14" TextAlignment="Center" TextWrapping="Wrap" />
      </StackPanel>
    </Panel>
    <GridSplitter Grid.Row="1" Grid.Column="3" Classes="panel" ResizeDirection="Columns" DragCompleted="OnRightSplitterDragCompleted" />

    <!-- Right: printer, size, paper, copies, then Print -->
    <Border Grid.Row="1" Grid.Column="4" Background="{DynamicResource PanelBrush}">
      <Grid RowDefinitions="*,Auto">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="18,14,18,8">
          <StackPanel Spacing="8">
            <TextBlock Classes="section" Text="{l:Tr Printer}" />
            <TextBlock IsVisible="{Binding !HasPrinters}" Text="{l:Tr NoPrinter}" Classes="warn" TextWrapping="Wrap" />
            <ComboBox IsVisible="{Binding HasPrinters}" HorizontalAlignment="Stretch" ItemsSource="{Binding Printers}" SelectedItem="{Binding SelectedPrinter}" />
            <Button Classes="link" Focusable="False" Content="{l:Tr PrinterSettings}" Command="{Binding PrinterSettingsCommand}" IsVisible="{Binding HasPrinters}" ToolTip.Tip="{l:Tr PrinterSettingsTip}" />

            <TextBlock Classes="section" Text="{l:Tr PrintSize}" Margin="0,10,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding !IsSizeFixed}">
              <Button Classes="chip" Focusable="False" Padding="16,6" Content="10 × 15" Command="{Binding SetSizeCommand}" CommandParameter="{x:Static f:PrintFormats.P10x15}"
                      Classes.selected="{Binding SelectedSize.Id, Converter={x:Static s:EqualsConverter.Instance}, ConverterParameter=10x15}" />
              <Button Classes="chip" Focusable="False" Padding="16,6" Content="15 × 20" Command="{Binding SetSizeCommand}" CommandParameter="{x:Static f:PrintFormats.P15x20}"
                      Classes.selected="{Binding SelectedSize.Id, Converter={x:Static s:EqualsConverter.Instance}, ConverterParameter=15x20}" />
            </StackPanel>

            <!-- Crop | Whole for photos without their own crop (prompt_07 §3.5); ID sheets and collages keep their layout -->
            <StackPanel Spacing="6" IsVisible="{Binding HasPhotos}" Margin="0,4,0,0">
              <Border Classes="segbox" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                  <ToggleButton Classes="segacc" Focusable="False" MinWidth="80" Content="{l:Tr Fill}" IsChecked="{Binding !WholePhoto, Mode=OneWay}" Command="{Binding SetWholeCommand}" CommandParameter="{x:False}" ToolTip.Tip="{l:Tr PrintCropTip}" />
                  <ToggleButton Classes="segacc" Focusable="False" MinWidth="80" Content="{l:Tr Borders}" IsChecked="{Binding WholePhoto, Mode=OneWay}" Command="{Binding SetWholeCommand}" CommandParameter="{x:True}" ToolTip.Tip="{l:Tr PrintWholeTip}" />
                </StackPanel>
              </Border>
            </StackPanel>

            <TextBlock Classes="section" Text="{l:Tr Paper}" Margin="0,10,0,0" IsVisible="{Binding HasPrinters}" />
            <ComboBox IsVisible="{Binding HasPrinters}" HorizontalAlignment="Stretch" ItemsSource="{Binding Papers}" SelectedItem="{Binding SelectedPaper}" PlaceholderText="{l:Tr ChoosePaper}" />
            <TextBlock Text="{Binding NoMatchingPaperText}" IsVisible="{Binding HasNoMatchingPaper}" Classes="warn" FontSize="12" TextWrapping="Wrap" />
            <TextBlock Text="{Binding PaperNote}" IsVisible="{Binding PaperNote, Converter={x:Static ObjectConverters.IsNotNull}}" Classes="warn" FontSize="12" TextWrapping="Wrap" />

            <TextBlock Classes="section" Text="{l:Tr Copies}" Margin="0,10,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="square" Focusable="False" Content="−" Command="{Binding CopiesMinusCommand}" />
              <Border Background="{DynamicResource Panel2Brush}" CornerRadius="7" Width="56" Height="34">
                <TextBlock Text="{Binding Copies}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <Button Classes="square" Focusable="False" Content="+" Command="{Binding CopiesPlusCommand}" />
              <TextBlock Text="{l:Tr EachPhoto}" Classes="muted" VerticalAlignment="Center" />
            </StackPanel>

            <Border Background="{DynamicResource InfoBgBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,14,0,0">
              <TextBlock Text="{Binding LoadedPaperText}" TextWrapping="Wrap" FontWeight="SemiBold" />
            </Border>
            <TextBlock Text="{l:Tr QueueNote}" Classes="faint" FontSize="11.5" TextWrapping="Wrap" Margin="0,8,0,0" />
            <Button Classes="link" Focusable="False" Content="{l:Tr PrintCalibration}" Command="{Binding LoadCalibrationCommand}" ToolTip.Tip="{l:Tr PrintCalibrationTip}" Margin="0,6,0,0" />
          </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Spacing="8" Margin="18,8,18,16">
          <Button Focusable="False" HorizontalAlignment="Stretch" Content="{Binding ClearText}" Command="{Binding ClearCommand}" IsEnabled="{Binding HasItems}" />
          <Button Classes="primary" Focusable="False" HorizontalAlignment="Stretch" MinHeight="56" Command="{Binding PrintCommand}" IsEnabled="{Binding CanPrint}">
            <TextBlock Text="{Binding PrintButtonText}" FontSize="17" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
